package Tsuzuri::Metadata;

use 5.010;
use strict;
use warnings;

use Tsuzuri::Config ();

our $VERSION = '0.01';

sub split {
    my ($class, $document, %opt) = @_;
    $document = '' unless defined $document;
    my $source = defined $opt{source} ? $opt{source} : '<document>';

    $document =~ s/^\x{FEFF}//;
    return ({}, $document) unless $document =~ /\A---[ \t]*(?:\r?\n|\z)/;

    my $opening_end = $+[0];
    my $rest = substr($document, $opening_end);
    my $offset = 0;
    my $line = 2;
    while ($offset <= length($rest)) {
        my $newline = index($rest, "\n", $offset);
        my $end = $newline >= 0 ? $newline : length($rest);
        my $candidate = substr($rest, $offset, $end - $offset);
        $candidate =~ s/\r\z//;
        if ($candidate =~ /\A---[ \t]*\z/) {
            my $metadata_text = substr($rest, 0, $offset);
            # Exclude the newline immediately before the closing fence.
            $metadata_text =~ s/\r?\n\z//;
            my $body_at = $newline >= 0 ? $newline + 1 : length($rest);
            my $body = substr($rest, $body_at);
            my $metadata = Tsuzuri::Config->parse(
                $metadata_text,
                source => $source . ' (front matter)'
            );
            return ($metadata, $body);
        }
        last if $newline < 0;
        $offset = $newline + 1;
        $line++;
    }

    die "$source:1: front matter has no closing --- fence\n";
}

sub parse {
    my ($class, $document, %opt) = @_;
    my ($meta, $body) = $class->split($document, %opt);
    return {
        meta => $meta,
        metadata => $meta,
        body => $body,
    };
}

sub load {
    my ($class, $path) = @_;
    die "document path is required\n" unless defined $path && $path ne '';
    open my $fh, '<:encoding(UTF-8)', $path
        or die "cannot read document '$path': $!\n";
    local $/;
    my $document = <$fh>;
    close $fh or die "cannot close document '$path': $!\n";
    return $class->parse($document, source => $path);
}

1;

__END__

