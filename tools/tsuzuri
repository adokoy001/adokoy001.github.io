package Tsuzuri::Config;

use 5.010;
use strict;
use warnings;
use Encode qw(decode FB_CROAK);

our $VERSION = '0.01';
my $MAX_INPUT_LENGTH = 4 * 1024 * 1024;
my $MAX_ARRAY_LENGTH = 1024 * 1024;
my $MAX_ARRAY_LINES = 4096;
my $MAX_ARRAY_DEPTH = 32;

sub parse {
    my ($class, $text, %opt) = @_;
    $text = '' unless defined $text;
    my $source = defined $opt{source} ? $opt{source} : '<string>';
    _error($source, 1, 'configuration exceeds the 4 MiB input limit')
        if length($text) > $MAX_INPUT_LENGTH;

    # A decoded character string is expected here.  load() supplies one; callers
    # which already have a string can pass it without any byte round-trip.
    $text =~ s/^\x{FEFF}//;
    $text =~ s/\r\n?/\n/g;

    my $root = {};
    my $section = [];
    my @lines = split /\n/, $text, -1;

    for (my $i = 0; $i < @lines; $i++) {
        my $line_no = $i + 1;
        my $line = _strip_comment($lines[$i]);
        $line = _trim($line);
        next if $line eq '';

        if ($line =~ /^\[([^\[\]]+)\]$/) {
            my $name = _trim($1);
            my @parts = _parse_path($name, $source, $line_no);
            _ensure_section($root, \@parts, $source, $line_no);
            $section = \@parts;
            next;
        }

        my ($key, $value_text) = _split_assignment($line);
        _error($source, $line_no, 'expected "key = value" or a [section]')
            unless defined $key;

        # Arrays may be laid out across lines.  This is deliberately the only
        # multiline value form, keeping the grammar small and deterministic.
        if (_trim($value_text) =~ /^\[/) {
            my $state = {depth => 0, quote => '', escape => 0};
            _scan_array_state($value_text, $state, $source, $line_no);
            my @chunks = ($value_text);
            my $length = length($value_text);
            _error($source, $line_no, 'array exceeds the 1 MiB value limit')
                if $length > $MAX_ARRAY_LENGTH;
            my $continuations = 0;
            while ($state->{depth} > 0 && $i + 1 < @lines) {
                _error($source, $line_no,
                    'multiline array exceeds the 4096-line limit')
                    if ++$continuations > $MAX_ARRAY_LINES;
                $i++;
                my $continuation = _strip_comment($lines[$i]);
                $length += 1 + length($continuation);
                _error($source, $line_no,
                    'array exceeds the 1 MiB value limit')
                    if $length > $MAX_ARRAY_LENGTH;
                push @chunks, $continuation;
                _scan_array_state("\n" . $continuation, $state,
                    $source, $line_no);
            }
            _error($source, $line_no, 'unterminated array')
                if $state->{depth} != 0 || $state->{quote} ne '';
            $value_text = join("\n", @chunks);
        }

        my @key_path = _parse_path(_trim($key), $source, $line_no);
        my @path = (@{$section}, @key_path);
        my $value = _parse_value(_trim($value_text), $source, $line_no);
        _assign($root, \@path, $value, $source, $line_no);
    }

    return $root;
}

sub load {
    my ($class, $path) = @_;
    die "config path is required\n" unless defined $path && $path ne '';

    open my $fh, '<:raw', $path
        or die "cannot read config '$path': $!\n";
    local $/;
    my $bytes = <$fh>;
    close $fh or die "cannot close config '$path': $!\n";
    my $text;
    my $ok = eval {
        $text = decode('UTF-8', defined($bytes) ? $bytes : '', FB_CROAK);
        1;
    };
    die "$path: configuration is not valid UTF-8\n" unless $ok;
    return $class->parse($text, source => $path);
}

sub parse_file { return shift->load(@_); }

sub _split_assignment {
    my ($line) = @_;
    my $quote = '';
    my $escape = 0;
    for (my $i = 0; $i < length($line); $i++) {
        my $c = substr($line, $i, 1);
        if ($quote ne '') {
            if ($escape) { $escape = 0; next; }
            if ($quote eq '"' && $c eq '\\') { $escape = 1; next; }
            if ($c eq $quote) { $quote = ''; }
            next;
        }
        if ($c eq '"' || $c eq "'") { $quote = $c; next; }
        return (substr($line, 0, $i), substr($line, $i + 1)) if $c eq '=';
    }
    return;
}

sub _strip_comment {
    my ($line) = @_;
    my $quote = '';
    my $escape = 0;
    for (my $i = 0; $i < length($line); $i++) {
        my $c = substr($line, $i, 1);
        if ($quote ne '') {
            if ($escape) { $escape = 0; next; }
            if ($quote eq '"' && $c eq '\\') { $escape = 1; next; }
            if ($c eq $quote) { $quote = ''; }
            next;
        }
        if ($c eq '"' || $c eq "'") { $quote = $c; next; }
        if (($c eq '#' || $c eq ';') &&
            ($i == 0 || substr($line, $i - 1, 1) =~ /\s/)) {
            return substr($line, 0, $i);
        }
    }
    return $line;
}

sub _scan_array_state {
    my ($text, $state, $source, $line) = @_;
    for (my $i = 0; $i < length($text); $i++) {
        my $c = substr($text, $i, 1);
        if ($state->{quote} ne '') {
            if ($state->{escape}) { $state->{escape} = 0; next; }
            if ($state->{quote} eq '"' && $c eq '\\') {
                $state->{escape} = 1;
                next;
            }
            if ($c eq $state->{quote}) { $state->{quote} = ''; }
            next;
        }
        if ($c eq '"' || $c eq "'") { $state->{quote} = $c; next; }
        if ($c eq '[') {
            $state->{depth}++;
            _error($source, $line, 'array nesting exceeds the depth limit of 32')
                if $state->{depth} > $MAX_ARRAY_DEPTH;
            next;
        }
        if ($c eq ']') {
            $state->{depth}--;
            _error($source, $line, 'array has an unmatched closing bracket')
                if $state->{depth} < 0;
            next;
        }
    }
    return $state;
}

sub _parse_path {
    my ($path, $source, $line) = @_;
    my @parts = split /\./, $path, -1;
    _error($source, $line, 'empty key or section name') unless @parts;
    for my $part (@parts) {
        $part = _trim($part);
        _error($source, $line, "invalid key '$part'")
            unless $part =~ /\A[A-Za-z_][A-Za-z0-9_-]*\z/;
    }
    return @parts;
}

sub _parse_value {
    my ($raw, $source, $line) = @_;
    _error($source, $line, 'missing value') if $raw eq '';

    if (substr($raw, 0, 1) eq '"') {
        _error($source, $line, 'unterminated quoted string')
            unless length($raw) >= 2 && substr($raw, -1, 1) eq '"';
        my $inner = substr($raw, 1, length($raw) - 2);
        return _unescape_double($inner, $source, $line);
    }
    if (substr($raw, 0, 1) eq "'") {
        _error($source, $line, 'unterminated literal string')
            unless length($raw) >= 2 && substr($raw, -1, 1) eq "'";
        my $inner = substr($raw, 1, length($raw) - 2);
        $inner =~ s/''/'/g;
        return $inner;
    }
    if (substr($raw, 0, 1) eq '[') {
        _error($source, $line, 'array must end with ]')
            unless substr($raw, -1, 1) eq ']';
        return _parse_array(substr($raw, 1, length($raw) - 2), $source, $line);
    }
    return 1 if lc($raw) eq 'true';
    return 0 if lc($raw) eq 'false';
    if ($raw =~ /\A[+-]?[0-9][0-9_]*\z/) {
        (my $number = $raw) =~ s/_//g;
        return 0 + $number;
    }

    # Bare strings are useful for paths, dates, modes and URLs.  Whitespace is
    # accepted at the edges only (already trimmed), never silently collapsed.
    _error($source, $line, 'bare values cannot contain control characters')
        if $raw =~ /[\x00-\x1F]/;
    return $raw;
}

sub _parse_array {
    my ($inner, $source, $line) = @_;
    return [] if _trim($inner) eq '';
    my @parts;
    my $start = 0;
    my $depth = 0;
    my $quote = '';
    my $escape = 0;
    for (my $i = 0; $i < length($inner); $i++) {
        my $c = substr($inner, $i, 1);
        if ($quote ne '') {
            if ($escape) { $escape = 0; next; }
            if ($quote eq '"' && $c eq '\\') { $escape = 1; next; }
            if ($c eq $quote) { $quote = ''; }
            next;
        }
        if ($c eq '"' || $c eq "'") { $quote = $c; next; }
        if ($c eq '[') { $depth++; next; }
        if ($c eq ']') { $depth--; next; }
        if ($c eq ',' && $depth == 0) {
            push @parts, substr($inner, $start, $i - $start);
            $start = $i + 1;
        }
    }
    _error($source, $line, 'unbalanced nested array') if $depth != 0 || $quote ne '';
    push @parts, substr($inner, $start);

    my @values;
    for (my $i = 0; $i < @parts; $i++) {
        my $part = _trim($parts[$i]);
        next if $part eq '' && $i == $#parts; # permit a trailing comma
        _error($source, $line, 'empty array item') if $part eq '';
        push @values, _parse_value($part, $source, $line);
    }
    return \@values;
}

sub _unescape_double {
    my ($text, $source, $line) = @_;
    my $out = '';
    for (my $i = 0; $i < length($text); $i++) {
        my $c = substr($text, $i, 1);
        if ($c ne '\\') { $out .= $c; next; }
        _error($source, $line, 'unfinished string escape') if ++$i >= length($text);
        my $e = substr($text, $i, 1);
        my %simple = ('n' => "\n", 'r' => "\r", 't' => "\t",
                      'b' => "\b", 'f' => "\f", '"' => '"', '\\' => '\\');
        if (exists $simple{$e}) { $out .= $simple{$e}; next; }
        if ($e eq 'u') {
            my $hex = substr($text, $i + 1, 4);
            _error($source, $line, 'invalid Unicode escape')
                unless length($hex) == 4 && $hex =~ /\A[0-9A-Fa-f]{4}\z/;
            my $code = hex($hex);
            _error($source, $line, 'surrogate code point is not valid here')
                if $code >= 0xD800 && $code <= 0xDFFF;
            $out .= chr($code);
            $i += 4;
            next;
        }
        _error($source, $line, "unknown string escape \\$e");
    }
    return $out;
}

sub _ensure_section {
    my ($root, $path, $source, $line) = @_;
    my $cursor = $root;
    for my $part (@{$path}) {
        if (exists $cursor->{$part}) {
            _error($source, $line, "'$part' is already a value")
                unless ref($cursor->{$part}) eq 'HASH';
        } else {
            $cursor->{$part} = {};
        }
        $cursor = $cursor->{$part};
    }
}

sub _assign {
    my ($root, $path, $value, $source, $line) = @_;
    my @parts = @{$path};
    my $last = pop @parts;
    my $cursor = $root;
    for my $part (@parts) {
        if (exists $cursor->{$part}) {
            _error($source, $line, "'$part' is already a value")
                unless ref($cursor->{$part}) eq 'HASH';
        } else {
            $cursor->{$part} = {};
        }
        $cursor = $cursor->{$part};
    }
    _error($source, $line, "duplicate key '$last'") if exists $cursor->{$last};
    $cursor->{$last} = $value;
}

sub _trim {
    my ($text) = @_;
    $text = '' unless defined $text;
    $text =~ s/\A\s+//;
    $text =~ s/\s+\z//;
    return $text;
}

sub _error {
    my ($source, $line, $message) = @_;
    die "$source:$line: $message\n";
}

1;

__END__

=head1 NAME

Tsuzuri::Config - Tsuzuri's small dependency-free configuration parser

=head1 SYNOPSIS

  my $config = Tsuzuri::Config->load('tsuzuri.conf');
  my $data = Tsuzuri::Config->parse("[site]\nname = \"My site\"\n");

