package Tsuzuri::Graph;

use 5.010;
use strict;
use warnings;
use utf8;
use Digest::SHA qw(sha256_hex);
use Encode qw(encode);
use Tsuzuri::Util qw(normalize_route route_path_info rfc3339_epoch slugify);

sub build {
    my ($class, $articles, %opt) = @_;
    die "Tsuzuri::Graph->build expects an array reference\n"
        unless ref($articles) eq 'ARRAY';

    my @items = @$articles;
    my (%by_id, %by_route);
    for my $article (@items) {
        die "Article graph entries must be hash references\n"
            unless ref($article) eq 'HASH';
        $article->{route} = _normalize_route($article->{route});
        $article->{url} = $article->{route} unless defined $article->{url};
        $article->{id} = _id_for($article) unless defined($article->{id}) && length($article->{id});
        die "Duplicate article id '$article->{id}'\n" if exists $by_id{$article->{id}};
        die "Duplicate route '$article->{route}'\n" if exists $by_route{$article->{route}};
        $by_id{$article->{id}} = $article;
        $by_route{$article->{route}} = $article;
        $article->{tags} = _list($article->{tags});
        $article->{categories} = _list(
            exists($article->{categories}) ? $article->{categories} : $article->{category}
        );
        $article->{series} = '' unless defined $article->{series};
    }

    my @chronological = sort {
        _date_key($a) <=> _date_key($b)
            || $a->{route} cmp $b->{route}
    } @items;
    for my $i (0 .. $#chronological) {
        my $article = $chronological[$i];
        $article->{previous} = $i > 0 ? _stub($chronological[$i - 1]) : undef;
        $article->{next} = $i < $#chronological ? _stub($chronological[$i + 1]) : undef;
    }

    my (%tags, %categories, %series);
    for my $article (@items) {
        _add_group(\%tags, $_, '/tags/', $article) for @{$article->{tags}};
        _add_group(\%categories, $_, '/categories/', $article) for @{$article->{categories}};
        _add_group(\%series, $article->{series}, '/series/', $article)
            if length $article->{series};
    }

    my %incoming;
    for my $article (@items) {
        my $links = $article->{links};
        next unless ref($links) eq 'ARRAY';
        for my $link (@$links) {
            my $url = ref($link) eq 'HASH' ? ($link->{url} || $link->{href}) : $link;
            next unless defined $url;
            $url =~ s/[?#].*$//;
            next unless $url =~ m{^/};
            next if $url =~ m{^//};
            $url = _normalize_route($url);
            next unless $by_route{$url};
            push @{$incoming{$url}}, _stub($article);
        }
    }
    for my $article (@items) {
        my @backlinks = sort { $a->{route} cmp $b->{route} }
            @{$incoming{$article->{route}} || []};
        $article->{backlinks} = \@backlinks;
    }

    my $related_limit = defined($opt{related_limit}) ? $opt{related_limit} : 5;
    for my $article (@items) {
        my @ranked;
        for my $candidate (@items) {
            next if $candidate->{id} eq $article->{id};
            my $score = _related_score($article, $candidate);
            next unless $score > 0;
            push @ranked, [$score, $candidate];
        }
        @ranked = sort {
            $b->[0] <=> $a->[0]
                || _date_key($b->[1]) <=> _date_key($a->[1])
                || $a->[1]{route} cmp $b->[1]{route}
        } @ranked;
        splice @ranked, $related_limit if @ranked > $related_limit;
        $article->{related} = [map {
            my $stub = _stub($_->[1]);
            $stub->{score} = $_->[0];
            $stub;
        } @ranked];
    }

    my @newest = sort {
        _date_key($b) <=> _date_key($a)
            || $a->{route} cmp $b->{route}
    } @items;

    return {
        articles   => \@newest,
        by_id      => \%by_id,
        by_route   => \%by_route,
        tags       => _groups(\%tags),
        categories => _groups(\%categories),
        series     => _groups(\%series),
    };
}

sub _list {
    my ($value) = @_;
    return [] unless defined $value;
    my @items = ref($value) eq 'ARRAY' ? @$value : ($value);
    my (%seen, @out);
    for my $item (@items) {
        next unless defined $item;
        $item =~ s/^\s+|\s+$//g;
        next unless length($item) && !$seen{$item}++;
        push @out, $item;
    }
    return \@out;
}

sub _id_for {
    my ($article) = @_;
    my $seed = join("\x1e", map { defined($_) ? $_ : '' }
        $article->{route}, $article->{title}, _date($article));
    return substr(sha256_hex(encode('UTF-8', $seed)), 0, 24);
}

sub _date {
    my ($article) = @_;
    return $article->{published_at} if defined $article->{published_at};
    return $article->{date} if defined $article->{date};
    return $article->{created_at} if defined $article->{created_at};
    return '';
}

sub _date_key {
    my ($article) = @_;
    my $date = _date($article);
    return 0 unless defined($date) && length($date);
    my $epoch = rfc3339_epoch($date);
    die "Invalid article date '$date'\n" unless defined $epoch;
    return $epoch;
}

sub _stub {
    my ($article) = @_;
    return {
        id           => $article->{id},
        title        => defined($article->{title}) ? $article->{title} : '',
        route        => $article->{route},
        url          => $article->{url},
        date         => _date($article),
        summary      => defined($article->{summary}) ? $article->{summary} : '',
    };
}

sub _add_group {
    my ($groups, $name, $prefix, $article) = @_;
    return unless defined($name) && length($name);
    my $slug = slugify($name);
    my $key = $name;
    $groups->{$key} ||= {
        name => $name,
        slug => $slug,
        route => _normalize_route($prefix . $slug),
        articles => [],
    };
    push @{$groups->{$key}{articles}}, $article;
}

sub _groups {
    my ($groups) = @_;
    my @out;
    for my $name (sort { lc($a) cmp lc($b) || $a cmp $b } keys %$groups) {
        my $group = $groups->{$name};
        my @articles = sort {
            _date_key($b) <=> _date_key($a) || $a->{route} cmp $b->{route}
        } @{$group->{articles}};
        push @out, {
            name => $group->{name},
            slug => $group->{slug},
            route => $group->{route},
            count => scalar(@articles),
            articles => \@articles,
        };
    }
    return \@out;
}

sub _related_score {
    my ($left, $right) = @_;
    my $score = 0;
    $score += 7 if length($left->{series}) && $left->{series} eq $right->{series};
    my %right_tags = map { $_ => 1 } @{$right->{tags}};
    $score += 3 for grep { $right_tags{$_} } @{$left->{tags}};
    my %right_categories = map { $_ => 1 } @{$right->{categories}};
    $score += 4 for grep { $right_categories{$_} } @{$left->{categories}};
    my %links = map { $_->{route} => 1 } @{$right->{backlinks} || []};
    $score += 1 if $links{$left->{route}};
    return $score;
}

sub _normalize_route {
    my ($route) = @_;
    $route = '/' unless defined($route) && length($route);
    die "Unsafe route contains control characters\n" if $route =~ /[\x00-\x1f]/;
    die "Unsafe route contains whitespace, a query, fragment, colon, or backslash\n"
        if $route =~ /[\s\\?#:]/;
    die "Unsafe route contains duplicate separators\n" if $route =~ m{//};
    die "Unsafe route contains unsupported characters\n"
        unless $route =~ m{\A/[A-Za-z0-9._~%/-]*\z};
    die "Unsafe route contains a dot segment\n" if $route =~ m{/(?:\.|\.\.)(?:/|\z)};
    $route =~ s{/+\z}{} unless $route eq '/';
    $route = normalize_route($route);
    return route_path_info($route, label => 'Unsafe route')->{route};
}

1;

__END__

