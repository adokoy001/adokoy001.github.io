package Tsuzuri::Search;

use 5.010;
use strict;
use warnings;
use utf8;
use B qw(svref_2object SVf_IOK SVf_NOK SVf_POK);

sub build {
    my ($class, $articles, %opt) = @_;
    die "Tsuzuri::Search->build expects an array reference\n"
        unless ref($articles) eq 'ARRAY';

    my @sorted = sort {
        ($a->{route} || '') cmp ($b->{route} || '')
    } @$articles;
    my (@documents, %postings);
    for my $number (0 .. $#sorted) {
        my $article = $sorted[$number];
        my $date = $article->{published_at} || $article->{date}
            || $article->{created_at} || '';
        my $summary = defined($article->{summary}) ? $article->{summary} : '';
        my $text = defined($article->{text}) ? $article->{text} : '';
        my @tags = ref($article->{tags}) eq 'ARRAY' ? @{$article->{tags}} : ();
        my @categories = ref($article->{categories}) eq 'ARRAY'
            ? @{$article->{categories}} : ();
        push @documents, {
            id         => defined($article->{id}) ? $article->{id} : "$number",
            title      => defined($article->{title}) ? $article->{title} : '',
            url        => $article->{url} || $article->{route} || '/',
            summary    => $summary,
            date       => $date,
            tags       => \@tags,
            categories => \@categories,
        };

        _add_field(\%postings, $number, $article->{title}, 12);
        _add_field(\%postings, $number, join(' ', @tags), 8);
        _add_field(\%postings, $number, join(' ', @categories), 6);
        _add_field(\%postings, $number, $summary, 4);
        _add_field(\%postings, $number, $text, 1);
    }

    my %index;
    for my $token (sort keys %postings) {
        my @rows = map { [0 + $_, 0 + $postings{$token}{$_}] }
            sort { $a <=> $b } keys %{$postings{$token}};
        $index{$token} = \@rows;
    }

    return {
        version   => 1,
        tokenizer => 'unicode-word+cjk-bigram',
        documents => \@documents,
        index     => \%index,
    };
}

sub tokenize {
    my ($class, $text) = @_;
    $text = '' unless defined $text;
    $text = lc($text);
    my (%seen, @tokens);

    while ($text =~ /([\p{Letter}\p{Number}]+)/g) {
        my $run = $1;
        if ($run =~ /[\x{3040}-\x{30ff}\x{3400}-\x{9fff}\x{f900}-\x{faff}\x{ac00}-\x{d7af}]/) {
            my @parts = split(/([^\x{3040}-\x{30ff}\x{3400}-\x{9fff}\x{f900}-\x{faff}\x{ac00}-\x{d7af}]+)/, $run);
            for my $part (@parts) {
                next unless length $part;
                if ($part =~ /^[\x{3040}-\x{30ff}\x{3400}-\x{9fff}\x{f900}-\x{faff}\x{ac00}-\x{d7af}]+$/) {
                    _cjk_tokens($part, \%seen, \@tokens);
                } else {
                    _push_token($part, \%seen, \@tokens);
                }
            }
        } else {
            _push_token($run, \%seen, \@tokens);
        }
    }
    return \@tokens;
}

sub to_json {
    my ($class, $index, %opt) = @_;
    return $class->encode_json($index, pretty => exists($opt{pretty}) ? $opt{pretty} : 0) . "\n";
}

sub encode_json {
    my ($class, $value, %opt) = @_;
    return _encode_json($value, $opt{pretty} ? 1 : 0, 0, '');
}

sub _encode_json {
    my ($value, $pretty, $depth, $key) = @_;
    return 'null' unless defined $value;
    my $ref = ref($value);
    if (!$ref) {
        return 0 + $value if _is_number_scalar($value);
        return _json_string($value);
    }
    return $$value ? 'true' : 'false' if $ref eq 'SCALAR';
    my $nl = $pretty ? "\n" : '';
    my $space = $pretty ? ' ' : '';
    my $indent = $pretty ? ('  ' x $depth) : '';
    my $next = $pretty ? ('  ' x ($depth + 1)) : '';
    if ($ref eq 'ARRAY') {
        return '[]' unless @$value;
        my @items = map { _encode_json($_, $pretty, $depth + 1, $key) } @$value;
        return '[' . $nl . $next . join(',' . $nl . $next, @items) . $nl . $indent . ']';
    }
    if ($ref eq 'HASH') {
        my @keys = sort keys %$value;
        return '{}' unless @keys;
        my @items = map { _json_string($_) . ':' . $space
            . _encode_json($value->{$_}, $pretty, $depth + 1, $_) } @keys;
        return '{' . $nl . $next . join(',' . $nl . $next, @items) . $nl . $indent . '}';
    }
    die "Cannot encode reference type $ref as JSON\n";
}

sub _is_number_scalar {
    my ($value) = @_;
    my $flags = svref_2object(\$value)->FLAGS;
    # A scalar with the string flag set remains a JSON string even when its
    # bytes happen to look numeric (IDs such as "001" must round-trip). Values
    # produced by arithmetic carry IOK/NOK without POK and are emitted as JSON
    # numbers. This uses only B, which is part of the Perl 5.10 core.
    return 0 if $flags & SVf_POK;
    return ($flags & (SVf_IOK | SVf_NOK)) ? 1 : 0;
}

sub _json_string {
    my ($value) = @_;
    $value = '' unless defined $value;
    $value =~ s/\\/\\\\/g;
    $value =~ s/"/\\"/g;
    $value =~ s/\x08/\\b/g;
    $value =~ s/\x0c/\\f/g;
    $value =~ s/\n/\\n/g;
    $value =~ s/\r/\\r/g;
    $value =~ s/\t/\\t/g;
    $value =~ s/([\x00-\x1f])/sprintf('\\u%04x', ord($1))/ge;
    return '"' . $value . '"';
}

sub _add_field {
    my ($postings, $document, $text, $weight) = @_;
    return unless defined($text) && length($text);
    my $tokens = __PACKAGE__->tokenize($text);
    my %frequency;
    $frequency{$_}++ for @$tokens;
    for my $token (keys %frequency) {
        my $count = $frequency{$token};
        $count = 8 if $count > 8;
        $postings->{$token}{$document} += $weight * $count;
    }
}

sub _cjk_tokens {
    my ($run, $seen, $tokens) = @_;
    my $length = length($run);
    if ($length == 1) {
        _push_token($run, $seen, $tokens);
        return;
    }
    for my $size (2, 3) {
        next if $length < $size;
        for my $i (0 .. $length - $size) {
            _push_token(substr($run, $i, $size), $seen, $tokens);
        }
    }
}

sub _push_token {
    my ($token, $seen, $tokens) = @_;
    return unless defined($token) && length($token);
    return if length($token) > 80;
    return if $seen->{$token}++;
    push @$tokens, $token;
}

1;

__END__

=head1 NAME

Tsuzuri::Search - dependency-free static full-text index builder

=head1 SYNOPSIS

  my $index = Tsuzuri::Search->build(\@articles);
  Tsuzuri::Search->to_json($index, pretty => 1);

=head1 DESCRIPTION

The index is designed for the small vanilla-JavaScript search client shipped
with Tsuzuri.  Latin text uses Unicode word runs.  Japanese, Chinese, and
Korean runs use overlapping bi-grams and tri-grams.  Title and taxonomy hits
receive greater weights than body hits.  Documents and posting lists are
sorted, so identical content produces byte-identical JSON.
C<encode_json> is also available to Tsuzuri's other generators.  Unlike a
regex-only encoder, it preserves numeric-looking Perl strings as JSON strings.

=cut

