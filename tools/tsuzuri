    return -1 unless substr($text, $open, 1) eq '[';
    my $depth = 1;
    my $escaped = 0;
    for (my $i = $open + 1; $i < length($text); $i++) {
        my $c = substr($text, $i, 1);
        if ($escaped) { $escaped = 0; next; }
        if ($c eq '\\') { $escaped = 1; next; }
        $depth++ if $c eq '[';
        if ($c eq ']') { $depth--; return $i if $depth == 0; }
    }
    return -1;
}

sub _parenthesized {
    my ($text, $open) = @_;
    return unless substr($text, $open, 1) eq '(';
    my $depth = 1;
    my $quote = '';
    my $escaped = 0;
    for (my $i = $open + 1; $i < length($text); $i++) {
        my $c = substr($text, $i, 1);
        if ($escaped) { $escaped = 0; next; }
        if ($c eq '\\') { $escaped = 1; next; }
        if ($quote ne '') { $quote = '' if $c eq $quote; next; }
        if ($c eq '"' || $c eq "'") { $quote = $c; next; }
        $depth++ if $c eq '(';
        if ($c eq ')') {
            $depth--;
            return (substr($text, $open + 1, $i - $open - 1), $i + 1) if $depth == 0;
