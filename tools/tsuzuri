package Tsuzuri::Markdown;

use 5.010;
use strict;
use warnings;

our $VERSION = '0.01';

sub new {
    my ($class, %opt) = @_;
    return bless {
        max_input   => defined $opt{max_input}   ? $opt{max_input}   : 8 * 1024 * 1024,
        max_nesting => defined $opt{max_nesting} ? $opt{max_nesting} : 64,
        max_operations => defined $opt{max_operations} ? $opt{max_operations} : 20_000_000,
        allow_html  => $opt{allow_html} ? 1 : 0,
    }, $class;
}

sub parse {
    my ($self, $source) = @_;
    $self = $self->new() unless ref $self;
    $source = '' unless defined $source;
    die "Markdown input exceeds configured size limit\n"
        if length($source) > $self->{max_input};
    $source =~ s/^\x{FEFF}//;
    $source =~ s/\r\n?/\n/g;
    my @lines = split /\n/, $source, -1;
    my $state = {
        footnotes => {}, footnote_sequence => [],
        inline_budget => { operations => 0, limit => $self->{max_operations} },
    };
    my $blocks = $self->_parse_blocks(\@lines, 0, $state);
    return {
        type => 'document',
        blocks => $blocks,
        footnotes => $state->{footnotes},
        footnote_sequence => $state->{footnote_sequence},
    };
}

sub parse_blocks {
    my ($self, $source) = @_;
    $self = $self->new() unless ref $self;
    return $self->parse($source)->{blocks};
}

sub parse_inline {
    my ($self, $source) = @_;
    $self = $self->new() unless ref $self;
    my $budget = { operations => 0, limit => $self->{max_operations} };
    return $self->_parse_inlines(defined $source ? $source : '', 0, $budget);
}

sub render {
    my ($self, $source) = @_;
    $self = $self->new() unless ref $self;
    my $document = ref($source) eq 'HASH' ? $source : $self->parse($source);
    my $ctx = {
        headings => [],
        links => [],
        slugs => {},
        footnotes => $document->{footnotes} || {},
        footnote_numbers => {},
        footnote_order => [],
        footnote_refs => {},
        footnote_ids => {},
        footnote_slug_seen => {},
    };
    my $html = $self->_render_blocks($document->{blocks} || [], $ctx);
    $html .= $self->_render_footnotes($ctx);
    my $text = $self->_blocks_text($document->{blocks} || []);
    return {
        html => $html,
        text => $text,
        headings => $ctx->{headings},
        links => $ctx->{links},
        ast => $document,
    };
}

sub _parse_blocks {
    my ($self, $lines, $depth, $state) = @_;
    die "Markdown block nesting limit exceeded\n" if $depth > $self->{max_nesting};
    my @blocks;
    my $i = 0;

    while ($i < @{$lines}) {
        my $line = $lines->[$i];
        if ($line =~ /^\s*$/) { $i++; next; }

        # Legacy literals and hand-audited embeds use a conspicuous container.
        # Both the explicit block and allow_html are required before bytes can
        # bypass escaping; merely placing an HTML tag in Markdown is never
        # sufficient.
        if ($line =~ /^ {0,3}:::trusted-html[ \t]*$/) {
            my @raw;
            my $closed = 0;
            $i++;
            while ($i < @{$lines}) {
                if ($lines->[$i] =~ /^ {0,3}:::[ \t]*$/) {
                    $closed = 1;
                    $i++;
                    last;
                }
                push @raw, $lines->[$i];
                $i++;
            }
            push @blocks, {
                type => 'html_block', html => join("\n", @raw),
                trusted => $self->{allow_html} && $closed ? 1 : 0,
                closed => $closed,
            };
            next;
        }

        # Fenced code blocks.  The exact opening character must close the fence.
        if ($line =~ /^ {0,3}(`{3,}|~{3,})[ \t]*(.*)$/) {
            my $fence = $1;
            my $info = _trim($2);
            my $char = substr($fence, 0, 1);
            my $minimum = length($fence);
            my @code;
            my $closed = 0;
            $i++;
            while ($i < @{$lines}) {
                my $candidate = $lines->[$i];
                if ($candidate =~ /^ {0,3}(\Q$char\E{$minimum,})[ \t]*$/) {
                    $closed = 1;
                    $i++;
                    last;
                }
                push @code, $candidate;
                $i++;
            }
            my ($language) = $info =~ /^([^ \t]+)/;
            push @blocks, {
                type => 'code_block', code => join("\n", @code),
                info => $info, language => defined $language ? $language : '',
                closed => $closed,
            };
            next;
        }

        if ($line =~ /^ {0,3}(#{1,6})(?:[ \t]+(.*)|[ \t]*)$/) {
            my $content = defined $2 ? $2 : '';
            $content =~ s/[ \t]+#+[ \t]*$//;
            push @blocks, {
                type => 'heading', level => length($1),
                children => $self->_parse_inlines($content, 0, $state->{inline_budget}),
            };
            $i++;
            next;
        }

        if (_is_horizontal_rule($line)) {
            push @blocks, { type => 'hr' };
            $i++;
            next;
        }

        if ($line =~ /^ {0,3}>/) {
            my @quoted;
            while ($i < @{$lines}) {
                my $q = $lines->[$i];
                if ($q =~ /^ {0,3}>[ \t]?(.*)$/) {
                    push @quoted, $1;
                    $i++;
                } elsif ($q =~ /^\s*$/) {
                    push @quoted, '';
                    $i++;
                    last unless $i < @{$lines} && $lines->[$i] =~ /^ {0,3}>/;
                } else {
                    last;
                }
            }
            push @blocks, {
                type => 'blockquote',
                blocks => $self->_parse_blocks(\@quoted, $depth + 1, $state),
            };
            next;
        }

        if ($line =~ /^ {0,3}\[\^([^\]\s]+)\]:[ \t]*(.*)$/) {
            my ($id, $first) = ($1, $2);
            my @definition = ($first);
            $i++;
            while ($i < @{$lines}) {
                my $continuation = $lines->[$i];
                if ($continuation =~ /^(?: {2,}|\t)(.*)$/) {
                    push @definition, $1;
                    $i++;
                } elsif ($continuation =~ /^\s*$/ &&
                         $i + 1 < @{$lines} && $lines->[$i + 1] =~ /^(?: {2,}|\t)/) {
                    push @definition, '';
                    $i++;
                } else {
                    last;
                }
            }
            if (!exists $state->{footnotes}{$id}) {
                $state->{footnotes}{$id} = $self->_parse_blocks(\@definition, $depth + 1, $state);
                push @{$state->{footnote_sequence}}, $id;
            }
            next;
        }

        my @list_match = _list_match($line);
        if (@list_match) {
            my ($list, $next) = $self->_parse_list($lines, $i, $depth, $state);
            push @blocks, $list;
            $i = $next;
            next;
        }

        if ($line =~ /^(?: {4}|\t)(.*)$/) {
            my @code;
            while ($i < @{$lines}) {
                if ($lines->[$i] =~ /^(?: {4}|\t)(.*)$/) {
                    push @code, $1;
                    $i++;
                } elsif ($lines->[$i] =~ /^\s*$/) {
                    push @code, '';
                    $i++;
                } else {
                    last;
                }
            }
            pop @code while @code && $code[-1] eq '';
            push @blocks, { type => 'code_block', code => join("\n", @code), info => '', language => '' };
            next;
        }

        if ($i + 1 < @{$lines} && _looks_like_table_row($line)) {
            my $align = _table_separator($lines->[$i + 1]);
            if ($align) {
                my @header_text = _split_table_row($line);
                if (@header_text == @{$align}) {
                    my @rows;
                    $i += 2;
                    while ($i < @{$lines} && _looks_like_table_row($lines->[$i]) &&
                           $lines->[$i] !~ /^\s*$/) {
                        my @cells = _split_table_row($lines->[$i]);
                        last if !@cells;
                        push @cells, '' while @cells < @{$align};
                        splice @cells, @{$align} if @cells > @{$align};
                        push @rows, [ map { $self->_parse_inlines($_, 0, $state->{inline_budget}) } @cells ];
                        $i++;
                    }
                    push @blocks, {
                        type => 'table', align => $align,
                        header => [ map { $self->_parse_inlines($_, 0, $state->{inline_budget}) } @header_text ],
                        rows => \@rows,
                    };
                    next;
                }
            }
        }

        # Setext headings have priority over an ordinary two-line paragraph.
        if ($i + 1 < @{$lines} && $lines->[$i + 1] =~ /^ {0,3}(=+|-+)[ \t]*$/ &&
            $line !~ /^\s*$/) {
            push @blocks, {
                type => 'heading', level => substr($1, 0, 1) eq '=' ? 1 : 2,
                children => $self->_parse_inlines(_trim($line), 0, $state->{inline_budget}),
            };
            $i += 2;
            next;
        }

        my @paragraph = ($line);
        $i++;
        while ($i < @{$lines} && $lines->[$i] !~ /^\s*$/) {
            last if _starts_block($lines, $i);
            # Leave a possible table delimiter with its header.
            last if $i + 1 < @{$lines} && _looks_like_table_row($lines->[$i]) &&
                    _table_separator($lines->[$i + 1]);
            push @paragraph, $lines->[$i];
            $i++;
        }
        push @blocks, {
            type => 'paragraph',
            children => $self->_parse_inlines(join("\n", @paragraph), 0, $state->{inline_budget}),
        };
    }
    return \@blocks;
}

sub _parse_list {
    my ($self, $lines, $start_index, $depth, $state) = @_;
    die "Markdown list nesting limit exceeded\n" if $depth > $self->{max_nesting};
    my ($first_indent, $first_marker, $first_text) = _list_match($lines->[$start_index]);
    my $ordered = $first_marker =~ /^\d/ ? 1 : 0;
    my ($start_number) = $first_marker =~ /^(\d+)/;
    $start_number = 1 unless defined $start_number;
    my @items;
    my $i = $start_index;

    while ($i < @{$lines}) {
        my ($indent, $marker, $text) = _list_match($lines->[$i]);
        last unless defined $marker;
        last unless $indent == $first_indent && (($marker =~ /^\d/) ? 1 : 0) == $ordered;

        my @item_lines = ($text);
        my $content_indent = $indent + length($marker) + 1;
        $i++;
        while ($i < @{$lines}) {
            my $next = $lines->[$i];
            my ($ni, $nm) = _list_match($next);
            last if defined $nm && $ni == $first_indent && (($nm =~ /^\d/) ? 1 : 0) == $ordered;
            last if $next !~ /^\s*$/ && _leading_spaces($next) <= $first_indent;
            if ($next =~ /^\s*$/) {
                push @item_lines, '';
                $i++;
                next;
            }
            my $remove = _leading_spaces($next);
            $remove = $content_indent if $remove > $content_indent;
            $remove = $first_indent + 2 if $remove < $first_indent + 2;
            push @item_lines, substr($next, $remove);
            $i++;
        }

        my $task;
        if (@item_lines && $item_lines[0] =~ /^\[([ xX])\][ \t]+(.*)$/) {
            $task = lc($1) eq 'x' ? 1 : 0;
            $item_lines[0] = $2;
        }
        push @items, {
            type => 'list_item', task => $task,
            blocks => $self->_parse_blocks(\@item_lines, $depth + 1, $state),
        };
    }

    return ({
        type => 'list', ordered => $ordered, start => $start_number,
        items => \@items,
    }, $i);
}

sub _parse_inlines {
    my ($self, $text, $depth, $budget) = @_;
    die "Markdown inline nesting limit exceeded\n" if $depth > $self->{max_nesting};
    $budget ||= { operations => 0, limit => $self->{max_operations} };
    my @nodes;
    my $i = 0;
    my $length = length($text);

    while ($i < $length) {
        _charge($budget, 1);

        if (substr($text, $i, 1) eq '\\' && $i + 1 < $length &&
            substr($text, $i + 1, 1) =~ /[\\`*{}\[\]()#+\-.!_>~|]/) {
            _push_text(\@nodes, substr($text, $i + 1, 1));
            $i += 2;
            next;
        }

        if (substr($text, $i, 1) eq '`') {
            my $ticks = 1;
            $ticks++ while $i + $ticks < $length && substr($text, $i + $ticks, 1) eq '`';
            my $marker = '`' x $ticks;
            my $end = index($text, $marker, $i + $ticks);
            _charge($budget, $end >= 0 ? $end - $i : $length - $i);
            if ($end >= 0) {
                my $code = substr($text, $i + $ticks, $end - $i - $ticks);
                $code =~ s/\n/ /g;
                $code = substr($code, 1, length($code) - 2)
                    if length($code) >= 2 && $code =~ /^ .* $/ && $code !~ /^ +$/;
                push @nodes, { type => 'code', text => $code };
                $i = $end + $ticks;
                next;
            }
        }

        if (substr($text, $i, 2) eq '  ' && $i + 2 < $length && substr($text, $i + 2, 1) eq "\n") {
            push @nodes, { type => 'br' };
            $i += 3;
            next;
        }

        if (substr($text, $i, 2) eq '[^') {
            my $close = index($text, ']', $i + 2);
            if ($close > $i + 2) {
                my $id = substr($text, $i + 2, $close - $i - 2);
                if ($id !~ /\s/) {
                    push @nodes, { type => 'footnote_ref', id => $id };
                    $i = $close + 1;
                    next;
                }
            }
        }

        my $is_image = substr($text, $i, 2) eq '![' ? 1 : 0;
        if ($is_image || substr($text, $i, 1) eq '[') {
            my $open = $i + ($is_image ? 1 : 0);
            my $close = _matching_bracket($text, $open);
            _charge($budget, $close >= 0 ? $close - $open + 1 : $length - $open);
            if ($close >= 0 && $close + 1 < $length && substr($text, $close + 1, 1) eq '(') {
                my ($inside, $after) = _parenthesized($text, $close + 1);
                _charge($budget, defined $inside ? $after - $close : $length - $close);
                if (defined $inside) {
                    my ($url, $title) = _link_target($inside);
                    if (defined $url) {
                        my $label = substr($text, $open + 1, $close - $open - 1);
                        push @nodes, {
                            type => $is_image ? 'image' : 'link',
                            children => $self->_parse_inlines($label, $depth + 1, $budget),
                            url => $url, title => $title,
                        };
                        $i = $after;
                        next;
                    }
                }
            }
        }

        if (substr($text, $i, 1) eq '<') {
            my $close = index($text, '>', $i + 1);
            if ($close > $i + 1) {
                my $target = substr($text, $i + 1, $close - $i - 1);
                if ($target =~ /\A(?:https?:\/\/|mailto:)[^\s<>]+\z/i) {
                    push @nodes, { type => 'link', children => [{ type => 'text', text => $target }], url => $target };
                    $i = $close + 1;
                    next;
                } elsif ($target =~ /\A[A-Za-z0-9.!#\$%&'*+\/=?^_`{|}~-]+\@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\z/) {
                    push @nodes, { type => 'link', children => [{ type => 'text', text => $target }], url => 'mailto:' . $target };
                    $i = $close + 1;
                    next;
                }
            }
        }

        # Common triple delimiters are represented as genuinely nested AST
        # nodes rather than being flattened by a sequence of substitutions.
        if (substr($text, $i, 3) eq '***' || substr($text, $i, 3) eq '___') {
            my $triple = substr($text, $i, 3);
            my $end = _find_unescaped($text, $triple, $i + 3);
            _charge($budget, $end >= 0 ? $end - $i : $length - $i);
            if ($end > $i + 3) {
                my $inside = substr($text, $i + 3, $end - $i - 3);
                my $inner = $self->_parse_inlines($inside, $depth + 1, $budget);
                push @nodes, { type => 'em', children => [{ type => 'strong', children => $inner }] };
                $i = $end + 3;
                next;
            }
        }

        my ($marker, $type);
        if (substr($text, $i, 2) eq '**' || substr($text, $i, 2) eq '__') {
            ($marker, $type) = (substr($text, $i, 2), 'strong');
        } elsif (substr($text, $i, 2) eq '~~') {
            ($marker, $type) = ('~~', 'del');
        } elsif (substr($text, $i, 1) eq '*' || substr($text, $i, 1) eq '_') {
            ($marker, $type) = (substr($text, $i, 1), 'em');
        }
        if (defined $marker) {
            my $end = _find_unescaped($text, $marker, $i + length($marker));
            _charge($budget, $end >= 0 ? $end - $i : $length - $i);
            if ($end > $i + length($marker)) {
                my $inside = substr($text, $i + length($marker), $end - $i - length($marker));
                push @nodes, { type => $type, children => $self->_parse_inlines($inside, $depth + 1, $budget) };
                $i = $end + length($marker);
                next;
            }
        }

        if (substr($text, $i, 1) eq "\n") {
            push @nodes, { type => 'softbreak' };
            $i++;
            next;
        }

        _push_text(\@nodes, substr($text, $i, 1));
        $i++;
    }
    return \@nodes;
}

sub _render_blocks {
    my ($self, $blocks, $ctx) = @_;
    my $html = '';
    for my $block (@{$blocks}) {
        my $type = $block->{type};
        if ($type eq 'paragraph') {
            $html .= '<p>' . $self->_render_inlines($block->{children}, $ctx) . "</p>\n";
        } elsif ($type eq 'heading') {
            my $text = _inline_text($block->{children});
            my $slug = _unique_slug($text, $ctx->{slugs});
            push @{$ctx->{headings}}, { level => $block->{level}, text => $text, id => $slug };
            $html .= '<h' . $block->{level} . ' id="' . _escape_html($slug) . '">' .
                     $self->_render_inlines($block->{children}, $ctx) . '</h' . $block->{level} . ">\n";
        } elsif ($type eq 'code_block') {
            my $class = '';
            if (defined $block->{language} && $block->{language} ne '') {
                my $language = $block->{language};
                $language =~ s/[^A-Za-z0-9_+.-]//g;
                $class = ' class="language-' . _escape_html($language) . '"' if $language ne '';
            }
            $html .= '<pre><code' . $class . '>' . _escape_html($block->{code}) . "</code></pre>\n";
        } elsif ($type eq 'html_block') {
            if ($block->{trusted}) {
                $html .= $block->{html};
                $html .= "\n" unless $html =~ /\n\z/;
            } else {
                $html .= '<pre class="trusted-html-disabled"><code>' .
                         _escape_html($block->{html}) . "</code></pre>\n";
            }
        } elsif ($type eq 'hr') {
            $html .= "<hr>\n";
        } elsif ($type eq 'blockquote') {
            $html .= "<blockquote>\n" . $self->_render_blocks($block->{blocks}, $ctx) . "</blockquote>\n";
        } elsif ($type eq 'list') {
            my $tag = $block->{ordered} ? 'ol' : 'ul';
            my $attr = $block->{ordered} && $block->{start} != 1 ? ' start="' . int($block->{start}) . '"' : '';
            my $has_tasks = 0;
            for my $item (@{$block->{items}}) { $has_tasks = 1 if defined $item->{task}; }
            $attr .= ' class="task-list"' if $has_tasks;
            $html .= '<' . $tag . $attr . ">\n";
            for my $item (@{$block->{items}}) {
                my $item_class = defined $item->{task} ? ' class="task-list-item"' : '';
                $html .= '<li' . $item_class . '>';
                if (defined $item->{task}) {
                    $html .= '<input type="checkbox" disabled' . ($item->{task} ? ' checked' : '') . '> ';
                }
                my $item_blocks = $item->{blocks};
                if (@{$item_blocks} == 1 && $item_blocks->[0]{type} eq 'paragraph') {
                    $html .= $self->_render_inlines($item_blocks->[0]{children}, $ctx) . "</li>\n";
                } else {
                    $html .= "\n" . $self->_render_blocks($item_blocks, $ctx) . "</li>\n";
                }
            }
            $html .= '</' . $tag . ">\n";
        } elsif ($type eq 'table') {
            $html .= "<table>\n<thead>\n<tr>";
            for (my $i = 0; $i < @{$block->{header}}; $i++) {
                my $style = _align_attr($block->{align}[$i]);
                $html .= '<th' . $style . '>' . $self->_render_inlines($block->{header}[$i], $ctx) . '</th>';
            }
            $html .= "</tr>\n</thead>\n<tbody>\n";
            for my $row (@{$block->{rows}}) {
                $html .= '<tr>';
                for (my $i = 0; $i < @{$row}; $i++) {
                    my $style = _align_attr($block->{align}[$i]);
                    $html .= '<td' . $style . '>' . $self->_render_inlines($row->[$i], $ctx) . '</td>';
                }
                $html .= "</tr>\n";
            }
            $html .= "</tbody>\n</table>\n";
        }
    }
    return $html;
}

sub _render_inlines {
    my ($self, $nodes, $ctx) = @_;
    my $html = '';
    for my $node (@{$nodes}) {
        my $type = $node->{type};
        if ($type eq 'text') {
            $html .= _escape_html($node->{text});
        } elsif ($type eq 'code') {
            $html .= '<code>' . _escape_html($node->{text}) . '</code>';
        } elsif ($type eq 'em' || $type eq 'strong' || $type eq 'del') {
            $html .= '<' . $type . '>' . $self->_render_inlines($node->{children}, $ctx) . '</' . $type . '>';
        } elsif ($type eq 'br') {
            $html .= "<br>\n";
        } elsif ($type eq 'softbreak') {
            $html .= "\n";
        } elsif ($type eq 'link') {
            my $label = $self->_render_inlines($node->{children}, $ctx);
            my $text = _inline_text($node->{children});
            my $url = _safe_url($node->{url}, 0);
            push @{$ctx->{links}}, { url => $node->{url}, text => $text, image => 0, safe => defined $url ? 1 : 0 };
            if (defined $url) {
                my $title = defined $node->{title} && $node->{title} ne '' ?
                    ' title="' . _escape_html($node->{title}) . '"' : '';
                $html .= '<a href="' . _escape_html($url) . '"' . $title . '>' . $label . '</a>';
            } else {
                $html .= $label;
            }
        } elsif ($type eq 'image') {
            my $alt = _inline_text($node->{children});
            my $url = _safe_url($node->{url}, 1);
            push @{$ctx->{links}}, { url => $node->{url}, text => $alt, image => 1, safe => defined $url ? 1 : 0 };
            if (defined $url) {
                my $title = defined $node->{title} && $node->{title} ne '' ?
                    ' title="' . _escape_html($node->{title}) . '"' : '';
                $html .= '<img src="' . _escape_html($url) . '" alt="' . _escape_html($alt) . '"' . $title . '>';
            } else {
                $html .= _escape_html($alt);
            }
        } elsif ($type eq 'footnote_ref') {
            my $id = $node->{id};
            if (exists $ctx->{footnotes}{$id}) {
                if (!exists $ctx->{footnote_numbers}{$id}) {
                    $ctx->{footnote_numbers}{$id} = scalar(@{$ctx->{footnote_order}}) + 1;
                    $ctx->{footnote_ids}{$id} = _unique_slug($id, $ctx->{footnote_slug_seen});
                    push @{$ctx->{footnote_order}}, $id;
                }
                my $number = $ctx->{footnote_numbers}{$id};
                my $count = ++$ctx->{footnote_refs}{$id};
                my $safe_id = $ctx->{footnote_ids}{$id};
                $html .= '<sup id="fnref-' . _escape_html($safe_id) . '-' . $count . '" class="footnote-ref">' .
                         '<a href="#fn-' . _escape_html($safe_id) . '">' . $number . '</a></sup>';
            } else {
                $html .= _escape_html('[^' . $id . ']');
            }
        }
    }
    return $html;
}

sub _render_footnotes {
    my ($self, $ctx) = @_;
    return '' unless @{$ctx->{footnote_order}};
    my $html = "<section class=\"footnotes\" aria-label=\"Footnotes\">\n<ol>\n";
    for my $id (@{$ctx->{footnote_order}}) {
        my $safe_id = $ctx->{footnote_ids}{$id};
        my $body = $self->_render_blocks($ctx->{footnotes}{$id}, $ctx);
        $body =~ s/\n\z//;
        my $backrefs = '';
        my $count = $ctx->{footnote_refs}{$id} || 1;
        for my $n (1 .. $count) {
            $backrefs .= ' <a href="#fnref-' . _escape_html($safe_id) . '-' . $n .
                         '" class="footnote-backref" aria-label="Back to reference">&#8617;</a>';
        }
        if ($body =~ s{</p>\z}{$backrefs</p>}) {
            # Backlinks remain inside a simple final paragraph.
        } else {
            $body .= $backrefs;
        }
        $html .= '<li id="fn-' . _escape_html($safe_id) . '">' . $body . "</li>\n";
    }
    $html .= "</ol>\n</section>\n";
    return $html;
}

sub _blocks_text {
    my ($self, $blocks) = @_;
    my @parts;
    for my $block (@{$blocks}) {
        my $type = $block->{type};
        if ($type eq 'paragraph' || $type eq 'heading') {
            push @parts, _inline_text($block->{children});
        } elsif ($type eq 'code_block') {
            push @parts, $block->{code};
        } elsif ($type eq 'html_block') {
            my $raw = $block->{html};
            if ($block->{trusted}) {
                $raw =~ s/<[^>]*>/ /g;
                $raw =~ s/\s+/ /g;
                $raw = _trim($raw);
            }
            push @parts, $raw;
        } elsif ($type eq 'blockquote') {
            push @parts, $self->_blocks_text($block->{blocks});
        } elsif ($type eq 'list') {
            for my $item (@{$block->{items}}) {
                push @parts, $self->_blocks_text($item->{blocks});
            }
        } elsif ($type eq 'table') {
            push @parts, join("\t", map { _inline_text($_) } @{$block->{header}});
            for my $row (@{$block->{rows}}) {
                push @parts, join("\t", map { _inline_text($_) } @{$row});
            }
        }
    }
    return join("\n\n", grep { defined $_ && $_ ne '' } @parts);
}

sub _inline_text {
    my ($nodes) = @_;
    my $text = '';
    for my $node (@{$nodes || []}) {
        my $type = $node->{type};
        if ($type eq 'text' || $type eq 'code') { $text .= $node->{text}; }
        elsif ($type eq 'br' || $type eq 'softbreak') { $text .= "\n"; }
        elsif ($type eq 'em' || $type eq 'strong' || $type eq 'del' ||
               $type eq 'link' || $type eq 'image') { $text .= _inline_text($node->{children}); }
        elsif ($type eq 'footnote_ref') { $text .= '[^' . $node->{id} . ']'; }
    }
