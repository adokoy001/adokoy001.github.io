    $url =~ s/\\([()\\])/$1/g;
    $tail = _trim($tail);
    my $title;
    if ($tail ne '') {
        if ($tail =~ /^"(.*)"$/s || $tail =~ /^'(.*)'$/s || $tail =~ /^\((.*)\)$/s) {
            $title = $1;
        } else {
            return;
