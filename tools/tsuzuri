sub _align_attr {
    my ($align) = @_;
    return '' unless defined $align && $align ne '';
    return ' style="text-align: ' . $align . '"';
}

sub _leading_spaces {
    my ($line) = @_;
    my ($space) = $line =~ /^( *)/;
    return length($space || '');
}

sub _push_text {
    my ($nodes, $text) = @_;
    if (@{$nodes} && $nodes->[-1]{type} eq 'text') { $nodes->[-1]{text} .= $text; }
    else { push @{$nodes}, { type => 'text', text => $text }; }
}

sub _escape_html {
    my ($text) = @_;
    $text = '' unless defined $text;
    $text =~ s/&/&amp;/g;
    $text =~ s/</&lt;/g;
    $text =~ s/>/&gt;/g;
    $text =~ s/"/&quot;/g;
    $text =~ s/'/&#39;/g;
    return $text;
}

sub _trim {
    my ($text) = @_;
    $text = '' unless defined $text;
    $text =~ s/^\s+//;
    $text =~ s/\s+$//;
    return $text;
}

1;

