sub new {
    my ($class, %arg) = @_;
    my $root = File::Spec->rel2abs(defined($arg{root}) ? $arg{root} : '.');
    die "Site root does not exist: $root\n" unless -d $root;
    my $config = $arg{config};
    if (!defined $config) {
        my $path = File::Spec->catfile($root, 'tsuzuri.conf');
        $config = -f $path ? Tsuzuri::Config->load($path) : {};
    }
    die "Builder config must be a hash reference\n" unless ref($config) eq 'HASH';
    return bless {
        root     => $root,
        config   => $config,
        warnings => [],
        navigation => $arg{navigation},
        check      => $arg{check} ? 1 : 0,
        verbose    => $arg{verbose} ? 1 : 0,
        output     => $arg{output},
    }, $class;
}

sub build {
    my ($self, %arg) = @_;
    my $root = $self->{root};
    my $config = $self->{config};
    $self->{warnings} = [];
    _validate_config_schema($config);

    my $output_setting = defined($arg{output}) ? $arg{output}
        : defined($self->{output}) ? $self->{output}
        : _cfg($config, [qw(build output)], 'public');
    _require_text($output_setting, 'build output', 0);
    my $output = File::Spec->rel2abs($output_setting, $root);
    _assert_child($root, $output, 'build output');
    _assert_no_symlink_path($root, $output, 'build output');
    die "Build output cannot be the site root\n" if File::Spec->canonpath($root) eq File::Spec->canonpath($output);
    my $output_rel = File::Spec->abs2rel($output, $root);
    my ($output_top) = File::Spec->splitdir($output_rel);
    my %source_roots = map { $_ => 1 } qw(content standalone static assets theme themes lib share t docs examples tools .tsuzuri);
    die "Build output overlaps protected source directory '$output_top'\n"
        if defined($output_top) && $source_roots{lc($output_top)};
    die "Build output must be a directory path, not an existing file: $output\n"
        if -e $output && !-d $output;
    _validate_existing_output($output) if -e $output && !($self->{check} || $arg{check});

    my $navigation = defined($arg{navigation}) ? $arg{navigation}
        : defined($self->{navigation}) ? $self->{navigation}
        : _cfg($config, [qw(build navigation)], 'hybrid');
    _require_text($navigation, 'navigation', 0);
    $navigation = lc($navigation);
    die "navigation must be document, spa, or hybrid\n"
        unless $navigation eq 'document' || $navigation eq 'spa' || $navigation eq 'hybrid';

    my $content_dir = File::Spec->catdir($root, 'content');
    my ($articles, $source_hashes) = $self->_load_articles($content_dir, %arg);
    my $related = _cfg($config, [qw(content related_limit)], 5);
    my $graph = Tsuzuri::Graph->build($articles, related_limit => $related);

    my $theme = $self->_theme_dir;
    my $stage = tempdir('.tsuzuri-stage-XXXXXX', DIR => $root, CLEANUP => 0);
    my $clean = _cfg($config, [qw(build clean)], 1);
    my $ok;
    my $stats;
    eval {
        $stats = $self->_render_site(
            stage       => $stage,
            output      => $output,
            graph       => $graph,
            theme       => $theme,
            clean       => $clean,
            navigation  => $navigation,
            source_hashes => $source_hashes,
        );
        $ok = 1;
        1;
    } or do {
        my $error = $@ || "Unknown build error\n";
        rmtree($stage) if -d $stage;
        die $error;
    };

    if ($self->{check} || $arg{check}) {
        rmtree($stage) if -d $stage;
        $stats->{output} = $output;
        $stats->{checked} = 1;
        $stats->{warnings} = [@{$self->{warnings}}];
        return $stats;
    }
    my $backup;
    if (-e $output) {
        die "Build output is a symbolic link: $output\n" if -l $output;
        $backup = tempdir('.tsuzuri-backup-XXXXXX', DIR => $root, CLEANUP => 0);
        rmdir($backup) or die "Could not prepare output backup $backup: $!\n";
        rename($output, $backup) or die "Could not move old output to backup: $!\n";
    }
    mkpath(dirname($output)) unless -d dirname($output);
    if (!rename($stage, $output)) {
        my $publish_error = "$!";
        rmtree($stage) if -d $stage;
        if (defined($backup) && -e $backup) {
            if (!rename($backup, $output)) {
                die "Could not publish output ($publish_error), and rollback failed: $!; backup remains at $backup\n";
            }
        }
        die "Could not publish build output $output: $publish_error; previous output restored\n";
    }
    if (defined($backup) && -e $backup) {
        rmtree($backup);
        push @{$self->{warnings}}, {
            code => 'build.backup_cleanup',
            message => "Old output backup could not be removed: $backup",
        } if -e $backup;
    }
    $stats->{output} = $output;
    $stats->{warnings} = [@{$self->{warnings}}];
    return $stats;
}

sub warnings { return $_[0]{warnings}; }

sub _load_articles {
    my ($self, $content_dir, %arg) = @_;
    my @paths = grep { /\.md\z/i } @{list_files($content_dir)};
    my (@articles, @hashes);
    my $trusted_sources = _trusted_html_source_map($self->{config});
    require Tsuzuri::Markdown;
    for my $path (@paths) {
        die "Content source may not be a symbolic link: $path\n" if -l $path;
        my $document = slurp_utf8($path);
        _validate_document_text($document, $path);
        my ($meta, $body) = Tsuzuri::Metadata->split($document, source => $path);
        my $source_rel = File::Spec->abs2rel($path, $self->{root});
        $source_rel =~ tr{\\}{/};
        die "Content source escapes the site root: $path\n"
            if $source_rel eq '..' || $source_rel =~ m{\A\.\./};
        _validate_article_metadata($meta, $path, $trusted_sources, $source_rel);
        next if $meta->{draft} && !$arg{include_drafts};

        my $parser = Tsuzuri::Markdown->new(
            source     => $path,
            allow_html => $meta->{trusted_html} ? 1 : 0,
        );
        my $rendered = $parser->render($body);
        die "Markdown renderer returned an invalid result for $path\n"
            unless ref($rendered) eq 'HASH';

        my $relative = File::Spec->abs2rel($path, $content_dir);
        $relative =~ tr{\\}{/};
        my ($kind, $route, $slug) = _route_for($relative, $meta);
        my $title = defined($meta->{title}) && length($meta->{title})
            ? $meta->{title} : _heading_title($rendered, $slug);
        my $text = defined($rendered->{text}) ? $rendered->{text} : _strip_html($rendered->{html});
        my $summary = defined($meta->{summary}) && length($meta->{summary})
            ? $meta->{summary} : _excerpt($text, 180);
        my $date = $meta->{published_at} || $meta->{date} || $meta->{created_at}
            || _date_from_path($relative) || '1970-01-01T00:00:00Z';
        my $updated = $meta->{updated_at} || $date;
        _require_date($date, "$path: publication date");
        _require_date($updated, "$path: updated date");
        my $tags = _array($meta->{tags});
        my $categories = _array(exists($meta->{categories})
            ? $meta->{categories} : $meta->{category});
        push @articles, {
            %$meta,
            source       => $path,
            source_rel   => $relative,
            kind         => $kind,
            slug         => $slug,
            route        => $route,
            url          => $route,
            title        => $title,
            summary      => $summary,
            date         => $date,
            published_at => $date,
            updated_at   => $updated,
            tags         => $tags,
            categories   => $categories,
            html         => defined($rendered->{html}) ? $rendered->{html} : '',
            text         => $text,
            headings     => ref($rendered->{headings}) eq 'ARRAY' ? $rendered->{headings} : [],
            links        => ref($rendered->{links}) eq 'ARRAY' ? $rendered->{links} : [],
        };
        push @hashes, $relative . ':' . sha256_hex(encode('UTF-8', $document));
    }
    return (\@articles, \@hashes);
}

sub _render_site {
    my ($self, %arg) = @_;
    my $stage = $arg{stage};
    my $graph = $arg{graph};
    my $theme = $arg{theme};
    my $navigation = $arg{navigation};
    my $config = $self->{config};
    my $site = _site($config);
    my $per_page = _cfg($config, [qw(content posts_per_page)], 10);
    $per_page = 10 unless defined($per_page) && $per_page =~ /^\d+$/ && $per_page > 0;
    my $static_count = 0;
    my $static_dir = File::Spec->catdir($self->{root}, 'static');
    $static_count = _copy_assets($static_dir, $stage) if -d $static_dir;

    my $templates = _load_templates($theme);
    require Tsuzuri::Template;
    my %partials = map { $_ => $templates->{$_} }
        grep { /^partial-/ } keys %$templates;
    my $engine = Tsuzuri::Template->new(partials => \%partials);

    my (%occupied, @routes, @route_manifest, @standalone_offline_assets,
        %offline_route_excluded);
    my $pages = 0;
    my $write_page = sub {
        my ($route, $title, $kind, $content, %page_opt) = @_;
        $route = _normalize_route($route);
        die "Generated route uses a protected publication path: $route\n"
            if _reserved_publication_route($route);
        die "Generated route collision at $route\n" if $occupied{$route}++;
        my $page_navigation = $page_opt{navigation} || $navigation;
        my $html = $self->_layout(
            engine     => $engine,
            templates  => $templates,
            site       => $site,
            route      => $route,
            title      => $title,
            kind       => $kind,
            content    => $content,
            navigation => $page_navigation,
            description => $page_opt{description} || '',
            canonical_route => $page_opt{canonical_route},
            image => $page_opt{image},
            head_extra => $page_opt{head_extra} || '',
            script_extra => $page_opt{script_extra} || '',
        );
        _write_route($stage, $route, $html);
        my $data_url;
        if ($navigation eq 'spa' && $page_navigation ne 'document') {
            my $name = substr(sha256_hex(encode('UTF-8', $route)), 0, 24) . '.json';
            my $relative = File::Spec->catfile('_tsuzuri', 'pages', $name);
            _write_generated_file($stage, $relative, Tsuzuri::Search->encode_json({
                title => $title . ' · ' . $site->{title},
                description => $page_opt{description} || '',
                canonical => ($site->{url} || '')
                    . (defined($page_opt{canonical_route}) ? $page_opt{canonical_route} : $route),
                lang => $site->{language},
                body_class => 'page-' . $kind,
                body_html => $content,
            }, pretty => 0) . "\n");
            $relative =~ tr{\\}{/};
            $data_url = '/' . $relative;
        }
        push @routes, {route => $route, date => $page_opt{date}, updated_at => $page_opt{updated_at}};
        push @route_manifest, {
            route => $route, path => $route, title => $title, kind => $kind,
            (defined($data_url) ? (data => $data_url) : ()),
            ($page_navigation eq 'document' ? (document => \1) : ()),
        };
        $pages++;
    };

    for my $article (@{$graph->{articles}}) {
        my $content = $self->_article_html($templates, $engine, $article, $graph);
        $write_page->($article->{route}, $article->{title}, $article->{kind}, $content,
            description => $article->{summary}, date => $article->{date},
            updated_at => $article->{updated_at}, image => $article->{image},
            ($article->{trusted_html} ? (navigation => 'document') : ()));
    }

    for my $article (@{$graph->{articles}}) {
        for my $alias (@{_array($article->{aliases})}) {
            die "Alias for $article->{source_rel} must be a string\n" if ref($alias);
            my $alias_route = _normalize_route($alias);
            die "Alias for $article->{source_rel} duplicates its canonical route\n"
                if $alias_route eq $article->{route};
            my $target = $article->{route};
            my $redirect = '<section class="page-shell"><p class="eyebrow">Moved</p>'
                . '<h1>' . html_escape($article->{title}) . '</h1><p>This page has moved to '
                . '<a href="' . attr_escape($target) . '">' . html_escape($target) . '</a>.</p></section>';
            my $refresh = '<meta http-equiv="refresh" content="0; url=' . attr_escape($target) . '">'
                . '<meta name="robots" content="noindex">';
            $write_page->($alias_route, 'Moved: ' . $article->{title}, 'redirect', $redirect,
                description => 'This page has moved.', navigation => 'document',
                canonical_route => $target, head_extra => $refresh);
        }
    }

    my @posts = grep { ($_->{kind} || '') ne 'page' && !$_->{unlisted} } @{$graph->{articles}};
    my $page_count = @posts ? int((@posts + $per_page - 1) / $per_page) : 1;
    my $custom_home = exists $graph->{by_route}{'/'};
    for my $page_number (1 .. $page_count) {
        my $start = ($page_number - 1) * $per_page;
        my @slice;
        if (@posts) {
            my $end = $start + $per_page - 1 < $#posts ? $start + $per_page - 1 : $#posts;
            @slice = @posts[$start .. $end];
        }
        my $route = $custom_home
            ? ($page_number == 1 ? '/posts/' : "/posts/page/$page_number/")
            : ($page_number == 1 ? '/' : "/page/$page_number/");
        my $listing_title = $custom_home ? 'Posts' : $site->{title};
        my $listing = _listing_html(\@slice, $listing_title,
            _pager_html($page_number, $page_count, $custom_home ? '/posts/' : '/'));
        $write_page->($route, $listing_title, 'home', $listing,
            description => $site->{description});
    }

    $write_page->('/archive/', 'Archive', 'archive',
        _listing_html(\@posts, 'Archive', ''));
    $self->_taxonomy_pages($write_page, 'Tags', '/tags/', $graph->{tags});
    $self->_taxonomy_pages($write_page, 'Categories', '/categories/', $graph->{categories});
    $self->_taxonomy_pages($write_page, 'Series', '/series/', $graph->{series});

    my @search_articles = @{$graph->{articles}};
    my $standalone_count = 0;
    if (-d File::Spec->catdir($self->{root}, 'standalone')) {
        require Tsuzuri::Standalone;
        my $standalone = Tsuzuri::Standalone->new(
            root => $self->{root}, output => $stage,
            external_resources => _cfg($config, [qw(standalone external_resources)], 'warn'),
            trusted_apps => _cfg($config, [qw(standalone trusted_apps)], []),
            warnings => $self->{warnings},
            config_loader => sub { Tsuzuri::Config->load($_[0]) },
        );
        my $apps = $standalone->scan;
        for my $app (@$apps) {
            for my $candidate (grep {defined($_)} $app->{route}, $app->{play_route}) {
                die "Standalone route uses a protected publication namespace: $candidate\n"
                    if $candidate eq '/assets/' || index($candidate, '/assets/') == 0
                    || $candidate eq '/_tsuzuri/' || index($candidate, '/_tsuzuri/') == 0
                    || $candidate eq '/apps/';
                for my $generated (keys %occupied) {
                    die "Standalone route collides with generated page $generated: $candidate\n"
                        if _bundle_route_conflicts($candidate, $generated);
                }
            }
        }
        my $built = $standalone->build($apps);
        my @cards;
        for my $app (@$apps) {
            $standalone_count++;
            if ($app->{offline}) {
                my @copy_parts = @{route_path_info($app->{copy_route},
                    label => 'Standalone copy route')->{parts}};
                my $copy_root = File::Spec->catdir($stage, @copy_parts);
                for my $path (@{list_files($copy_root)}) {
                    my $relative = File::Spec->abs2rel($path, $copy_root);
                    $relative =~ tr{\\}{/};
                    my $relative_url = _filesystem_relative_url($relative);
                    push @standalone_offline_assets, $app->{copy_route} . $relative_url;
                    push @standalone_offline_assets, $app->{copy_route}
                        if $relative eq 'index.html';
                }
            }
            my $card = $standalone->listing_context($app);
            push @cards, $card;
            push @search_articles, {
                id => $app->{id}, title => $app->{title}, route => $app->{public_url},
                url => $app->{public_url}, summary => $app->{description}, text => $app->{description},
                tags => $app->{tags}, categories => [$app->{category}], date => '',
            } if $app->{searchable};
            if ($app->{mode} eq 'raw') {
                $occupied{$app->{route}} = 1;
                push @routes, {route => $app->{public_url}} if $app->{sitemap};
                push @route_manifest, {route => $app->{public_url}, path => $app->{public_url}, title => $app->{title}, kind => 'standalone', document => \1};
                $offline_route_excluded{$app->{public_url}} = 1
                    unless $app->{offline};
                next;
            }
            my $context = $standalone->landing_context($app);
            my $content = _standalone_html($context);
            $write_page->($app->{route}, $app->{title}, 'standalone', $content,
                description => $app->{description},
                navigation => $context->{navigation},
                head_extra => $context->{head_html} || '');
        }
        my $content = _app_listing_html(\@cards);
        $write_page->('/apps/', 'Apps & Games', 'apps', $content);
    } else {
        $write_page->('/apps/', 'Apps & Games', 'apps', _app_listing_html([]));
    }

    my $search = Tsuzuri::Search->build(\@search_articles);
    _write_generated_file($stage, 'search-index.json', Tsuzuri::Search->to_json($search));
    my $search_html = '<section class="page-shell" data-tsuzuri-search><h1>Search</h1>'
        . '<form class="search-form" role="search"><label for="site-search">Search the site</label>'
        . '<input id="site-search" data-search-input name="q" type="search" autocomplete="off">'
        . '<button type="submit">Search</button></form><p data-search-status aria-live="polite"></p>'
        . '<div id="search-results" data-search-results></div></section>';
    $write_page->('/search/', 'Search', 'search', $search_html);

    my $feed_site = {%$site, base_url => $site->{url}};
    _write_generated_file($stage, 'rss.xml', Tsuzuri::Feed->rss(\@posts, site => $feed_site));
    _write_generated_file($stage, 'atom.xml', Tsuzuri::Feed->atom(\@posts, site => $feed_site));
    _write_generated_file($stage, 'feed.json', Tsuzuri::Feed->json_feed(\@posts, site => $feed_site));
    _write_generated_file($stage, 'sitemap.xml', Tsuzuri::Feed->sitemap(\@routes, site => $feed_site));
    _write_generated_file($stage, 'robots.txt', Tsuzuri::Feed->robots(site => $feed_site));
    my $route_json = Tsuzuri::Search->encode_json({routes => [sort {$a->{route} cmp $b->{route}} @route_manifest]}, pretty => 1) . "\n";
    _write_generated_file($stage, 'routes.json', $route_json);
    _write_generated_file($stage, File::Spec->catfile('_tsuzuri', 'routes.json'), $route_json);

    my $manifest = {
        name => $site->{title}, short_name => $site->{title}, start_url => '/',
        display => 'standalone', background_color => '#f7f6f2', theme_color => '#20332d',
    };
    _write_generated_file($stage, 'manifest.webmanifest', Tsuzuri::Search->encode_json($manifest, pretty => 1) . "\n");
    my $not_found = '<section class="page-shell"><p class="eyebrow">404</p><h1>Page not found</h1>'
        . '<p>The requested page does not exist.</p><p><a href="/">Return home</a></p></section>';
    my $not_found_html = $self->_layout(engine=>$engine, templates=>$templates, site=>$site,
        route=>'/404.html', title=>'Page not found', kind=>'error', content=>$not_found,
        navigation=>$navigation, description=>'Page not found', head_extra=>'', script_extra=>'');
    _write_generated_file($stage, '404.html', $not_found_html);

    my $asset_count = $static_count
        + _copy_assets(File::Spec->catdir($theme, 'assets'), File::Spec->catdir($stage, 'assets'));
    my $share = $ENV{TSUZURI_SHARE_DIR}
        ? File::Spec->rel2abs($ENV{TSUZURI_SHARE_DIR})
        : File::Spec->catdir(dirname(dirname(dirname(__FILE__))), 'share');
    my $runtime = File::Spec->catdir($share, 'runtime');
    $asset_count += _copy_assets($runtime, File::Spec->catdir($stage, 'assets')) if -d $runtime;
    if (_cfg($config, [qw(offline enabled)], 0)) {
        my $worker_source = File::Spec->catfile($runtime, 'service-worker.js');
        die "Offline mode requires runtime service-worker.js\n" unless -f $worker_source;
        my $worker_dest = File::Spec->catfile($stage, 'service-worker.js');
        die "Generated service worker conflicts with an existing static file\n" if -e $worker_dest;
        copy($worker_source, $worker_dest)
            or die "Could not publish root service worker: $!\n";
        $asset_count++;
    }
    my $site_assets = File::Spec->catdir($self->{root}, 'assets');
    $asset_count += _copy_assets($site_assets, File::Spec->catdir($stage, 'assets')) if -d $site_assets;
    $asset_count += _copy_missing_assets($arg{output}, $stage)
        if !$arg{clean} && -d $arg{output};
    _validate_internal_links($stage, $graph->{articles});

    my @offline_assets;
    my $offline_manifest_payload;
    if (_cfg($config, [qw(offline enabled)], 0)) {
        @offline_assets = ('/', '/404.html', '/search-index.json');
        push @offline_assets, map { $_->{route} }
            grep { !$offline_route_excluded{$_->{route}} } @route_manifest;
        push @offline_assets, @standalone_offline_assets;
        for my $relative_root ('assets', File::Spec->catfile('_tsuzuri', 'pages')) {
            my $directory = File::Spec->catdir($stage, $relative_root);
            for my $path (@{list_files($directory)}) {
                my $relative = File::Spec->abs2rel($path, $stage);
                $relative =~ tr{\\}{/};
                push @offline_assets, '/' . $relative;
            }
        }
        push @offline_assets, '/_tsuzuri/routes.json', '/manifest.webmanifest';
        my %seen_offline;
        @offline_assets = sort grep { !$seen_offline{$_}++ } @offline_assets;

        # The manifest version is derived from build_id, so hash only its stable
        # payload here.  This makes cache-membership changes (notably a
        # standalone app's offline flag) rotate both build_id and worker bytes
        # without introducing a circular dependency.
        $offline_manifest_payload = Tsuzuri::Search->encode_json({
            offline => '/404.html', assets => \@offline_assets,
        }, pretty => 0);
    }

    my @hash_input;
    for my $path (@{list_files($stage)}) {
        my $relative = File::Spec->abs2rel($path, $stage);
        $relative =~ tr{\\}{/};
        next if $relative eq 'build.json'
            || $relative eq '.tsuzuri-generated'
            || $relative eq '_tsuzuri/sw-manifest.json'
            || $relative eq 'service-worker.js';
        push @hash_input, $relative . ':' . sha256_file($path);
    }
    push @hash_input, "\0offline-manifest:"
        . sha256_hex(encode('UTF-8', $offline_manifest_payload))
        if defined $offline_manifest_payload;
    my $build_id = sha256_hex(encode('UTF-8', join("\n", sort @hash_input)));
    if (_cfg($config, [qw(offline enabled)], 0)) {
        my $worker = File::Spec->catfile($stage, 'service-worker.js');
        my $source = slurp_utf8($worker);
        write_utf8($worker, $source . "\n/* Tsuzuri offline build: $build_id */\n");
    }
    _write_generated_file($stage, 'build.json', Tsuzuri::Search->encode_json({
        generator => 'Tsuzuri', version => 1, build_id => $build_id, navigation => $navigation,
        articles => scalar(@{$graph->{articles}}), pages => $pages,
    }, pretty => 1) . "\n");
    _write_generated_file($stage, '.tsuzuri-generated',
        "Tsuzuri generated output v1\n$build_id\n");
    if (_cfg($config, [qw(offline enabled)], 0)) {
        _write_generated_file($stage, File::Spec->catfile('_tsuzuri', 'sw-manifest.json'), Tsuzuri::Search->encode_json({
            version => $build_id, offline => '/404.html', assets => \@offline_assets,
        }, pretty => 1) . "\n");
    }

    return {
        articles  => scalar(@{$graph->{articles}}),
        posts     => scalar(@posts),
        pages     => $pages,
        assets    => $asset_count,
        apps      => $standalone_count,
        files     => scalar(@{list_files($stage)}),
        build_id  => $build_id,
        navigation => $navigation,
    };
}

sub _layout {
    my ($self, %arg) = @_;
    my $site = $arg{site};
    my $route = $arg{route};
    my $canonical_route = defined($arg{canonical_route}) ? $arg{canonical_route} : $route;
    my $canonical = ($site->{url} || '') . $canonical_route;
    my $router = '';
    if ($arg{navigation} eq 'hybrid') {
        $router = '<script type="module" src="/assets/router.js"></script>';
    } elsif ($arg{navigation} eq 'spa') {
        $router = '<script type="module">import {bootStaticSPA} from "/assets/spa.js"; bootStaticSPA();</script>';
    }
    $router .= '<script type="module" src="/assets/search.js"></script>'
        . '<script type="module">import {bootStaticSearch} from "/assets/search.js";'
        . 'document.addEventListener("tsuzuri:navigation-end",function(){bootStaticSearch()});'
        . 'document.addEventListener("tsuzuri:spa-page",function(){bootStaticSearch()});</script>';
    if (_cfg($self->{config}, [qw(offline enabled)], 0)) {
        $router .= '<script>if("serviceWorker" in navigator){addEventListener("load",function(){navigator.serviceWorker.register("/service-worker.js?manifest=/_tsuzuri/sw-manifest.json").then(function(r){r.update()})})}</script>';
    } else {
        $router .= '<script>if("serviceWorker" in navigator){addEventListener("load",function(){navigator.serviceWorker.getRegistration("/").then(function(r){if(!r)return;var w=r.active||r.waiting||r.installing;if(!w)return;var u=new URL(w.scriptURL);if(u.pathname!=="/service-worker.js"||!u.searchParams.has("manifest"))return;r.unregister().then(function(){if("caches" in window)caches.keys().then(function(a){a.forEach(function(n){if(n.indexOf("tsuzuri-static-")===0)caches.delete(n)})})})})})}</script>';
    }
    my $head = '<meta name="description" content="' . attr_escape($arg{description}) . '">'
        . '<link rel="canonical" href="' . attr_escape($canonical) . '">'
        . '<meta property="og:title" content="' . attr_escape($arg{title}) . '">'
        . '<meta property="og:description" content="' . attr_escape($arg{description}) . '">'
        . '<meta property="og:url" content="' . attr_escape($canonical) . '">'
        . _image_meta($site, $arg{image})
        . ($arg{head_extra} || '');
    my $nav = '<a class="brand" href="/">' . html_escape($site->{title}) . '</a>'
        . '<nav aria-label="Main navigation"><a href="/archive/">Archive</a>'
        . '<a href="/tags/">Tags</a><a href="/apps/">Apps</a><a href="/search/">Search</a></nav>';
    my $footer = '<p>Published with <a href="https://github.com/adokoy001/Tsuzuri">Tsuzuri</a>.</p>';
    my $body = {
        page => {title=>$arg{title}, route=>$route, kind=>$arg{kind}, description=>$arg{description}},
        site => $site,
        content_html => Tsuzuri::Template->safe($arg{content}),
    };
    my $content = $arg{engine}->render($arg{templates}{layout_content}, $body);
    my $context = {
        site => $site,
        page => {title=>$arg{title}, route=>$route, kind=>$arg{kind}, description=>$arg{description}},
        canonical => $canonical,
        navigation_mode => $arg{navigation},
        head_html => Tsuzuri::Template->safe($head),
        header_html => Tsuzuri::Template->safe($nav),
        content_html => Tsuzuri::Template->safe($content),
        footer_html => Tsuzuri::Template->safe($footer),
        scripts_html => Tsuzuri::Template->safe($router . ($arg{script_extra} || '')),
    };
    return $arg{engine}->render($arg{templates}{layout}, $context);
}

sub _article_html {
    my ($self, $templates, $engine, $article, $graph) = @_;
    my %tag_route = map { $_->{name} => $_->{route} } @{$graph->{tags}};
    my $tags = join('', map {
        '<a class="tag" href="' . attr_escape($tag_route{$_} || '/tags/') . '">' . html_escape($_) . '</a>'
    } @{$article->{tags}});
    my $relations = '<nav class="article-relations" aria-label="Article navigation">';
    $relations .= '<a rel="prev" href="' . attr_escape($article->{previous}{route}) . '">← '
        . html_escape($article->{previous}{title}) . '</a>' if $article->{previous};
    $relations .= '<a rel="next" href="' . attr_escape($article->{next}{route}) . '">'
        . html_escape($article->{next}{title}) . ' →</a>' if $article->{next};
    $relations .= '</nav>';
    my $related = '';
    if (@{$article->{related} || []}) {
        $related = '<aside class="related"><h2>Related</h2><ul>'
            . join('', map {'<li><a href="'.attr_escape($_->{route}).'">'.html_escape($_->{title}).'</a></li>'} @{$article->{related}})
            . '</ul></aside>';
    }
    return $engine->render($templates->{article}, {
        article => $article,
        tags_html => Tsuzuri::Template->safe($tags),
        body_html => Tsuzuri::Template->safe($article->{html}),
        relations_html => Tsuzuri::Template->safe($relations),
        related_html => Tsuzuri::Template->safe($related),
    });
}

sub _taxonomy_pages {
    my ($self, $write_page, $title, $route, $groups) = @_;
    my $index = '<section class="page-shell"><p class="eyebrow">Browse</p><h1>' . html_escape($title) . '</h1><ul class="taxonomy-list">'
        . join('', map {'<li><a href="'.attr_escape($_->{route}).'">'.html_escape($_->{name}).'</a> <span>'.$_->{count}.'</span></li>'} @$groups)
        . '</ul></section>';
    $write_page->($route, $title, 'taxonomy-index', $index);
    for my $group (@$groups) {
        $write_page->($group->{route}, "$title: $group->{name}", 'taxonomy',
            _listing_html($group->{articles}, $group->{name}, ''));
    }
}

sub _theme_dir {
    my ($self) = @_;
    my $configured = _cfg($self->{config}, [qw(theme path)], undef);
    return File::Spec->rel2abs($configured, $self->{root}) if defined($configured) && length($configured);
    my $local = File::Spec->catdir($self->{root}, 'theme');
    return $local if -d $local;
    if ($ENV{TSUZURI_SHARE_DIR}) {
        my $bundled = File::Spec->catdir(File::Spec->rel2abs($ENV{TSUZURI_SHARE_DIR}), 'default-theme');
        return $bundled if -d $bundled;
    }
    my $repo = dirname(dirname(dirname(__FILE__)));
    return File::Spec->catdir($repo, 'share', 'default-theme');
}

sub _load_templates {
    my ($theme) = @_;
    my $dir = File::Spec->catdir($theme, 'templates');
    my %templates;
    for my $name (qw(layout layout_content article)) {
        my $path = File::Spec->catfile($dir, "$name.html");
        die "Missing theme template: $path\n" unless -f $path;
        $templates{$name} = slurp_utf8($path);
    }
    for my $path (grep {/\.html\z/} @{list_files(File::Spec->catdir($dir, 'partials'))}) {
        my $name = basename($path); $name =~ s/\.html\z//;
        $templates{'partial-'.$name} = slurp_utf8($path);
    }
    return \%templates;
}

sub _route_for {
    my ($relative, $meta) = @_;
    my @parts = split('/', $relative);
    my $root_kind = @parts > 1 ? shift(@parts) : 'posts';
    my $kind = $root_kind eq 'pages' ? 'page' : 'post';
    my $file = pop @parts;
    $file =~ s/\.md\z//i;
    my $slug = defined($meta->{slug}) && length($meta->{slug}) ? slugify($meta->{slug}) : slugify($file eq 'index' ? ($parts[-1] || 'index') : $file);
    my $route;
    if (defined($meta->{route}) && length($meta->{route})) {
        $route = _normalize_route($meta->{route});
    } else {
        my @clean = map { slugify($_) } @parts;
        push @clean, $slug unless $file eq 'index';
        if ($kind eq 'page') {
            $route = @clean ? '/' . join('/', @clean) . '/' : '/';
        } else {
            $route = @clean ? '/posts/' . join('/', @clean) . '/' : '/posts/';
        }
        $route = _normalize_route($route);
    }
    return ($kind, $route, $slug);
}

sub _heading_title {
    my ($rendered, $slug) = @_;
    if (ref($rendered->{headings}) eq 'ARRAY' && @{$rendered->{headings}}) {
        my $first = $rendered->{headings}[0];
        return ref($first) eq 'HASH' ? ($first->{text} || $slug) : $first;
    }
    (my $title = $slug) =~ s/-/ /g;
    return ucfirst($title);
}

sub _date_from_path {
    my ($path) = @_;
    return "$1-$2-$3" if $path =~ m{(?:^|/)(\d{4})[-/](\d\d)[-/](\d\d)(?:[-/]|\.)};
    return undef;
}

sub _strip_html {
    my ($html) = @_;
    $html = '' unless defined $html;
    $html =~ s/<[^>]+>/ /g;
    $html =~ s/&(?:nbsp|amp|lt|gt|quot|#39);/ /g;
    $html =~ s/\s+/ /g;
    $html =~ s/^\s+|\s+$//g;
    return $html;
}

sub _excerpt {
    my ($text, $limit) = @_;
    $text = '' unless defined $text;
    $text =~ s/\s+/ /g; $text =~ s/^\s+|\s+$//g;
    return $text if length($text) <= $limit;
    return substr($text, 0, $limit - 1) . '…';
}

sub _listing_html {
    my ($articles, $title, $tail) = @_;
    return '<section class="page-shell"><p class="eyebrow">Tsuzuri</p><h1>' . html_escape($title) . '</h1><div class="entry-grid">'
        . join('', map {
            '<article class="entry-card"><p class="entry-date">'.html_escape($_->{date} || '').'</p><h2><a href="'.attr_escape($_->{route}).'">'.html_escape($_->{title}).'</a></h2><p>'.html_escape($_->{summary} || '').'</p></article>'
        } @$articles) . '</div>' . ($tail || '') . '</section>';
}

sub _pager_html {
    my ($current, $count, $base) = @_;
    return '' if $count <= 1;
    $base ||= '/';
    my $html = '<nav class="pager" aria-label="Pagination">';
    for my $page (1 .. $count) {
        my $route = $page == 1 ? $base
            : ($base eq '/' ? "/page/$page/" : $base . "page/$page/");
        $html .= $page == $current ? '<strong aria-current="page">'.$page.'</strong>'
            : '<a href="'.attr_escape($route).'">'.$page.'</a>';
    }
    return $html . '</nav>';
}

sub _standalone_html {
    my ($context) = @_;
    return '<section class="standalone-page"><h1>' . html_escape($context->{title}) . '</h1>'
        . ($context->{description} ? '<p class="lede">'.html_escape($context->{description}).'</p>' : '')
        . ($context->{mode} eq 'framed'
            ? '<div class="app-frame-wrap"><iframe class="app-frame" src="'.attr_escape($context->{iframe_src}).'" title="'.attr_escape($context->{iframe_title}).'"'
                . (defined($context->{iframe_sandbox}) ? ' sandbox="'.attr_escape($context->{iframe_sandbox}).'"' : '')
                . ($context->{allow} ? ' allow="'.attr_escape($context->{allow}).'"' : '')
                . ($context->{fullscreen} ? ' allowfullscreen' : '') . '></iframe></div>'
            : ($context->{body_html} || '')) . '</section>';
}

sub _app_listing_html {
    my ($apps) = @_;
    return '<section class="page-shell"><p class="eyebrow">Standalone bundles</p><h1>Apps &amp; Games</h1><div class="entry-grid">'
        . join('', map {'<article class="entry-card"><h2><a'.(($_->{mode} || '') eq 'raw' ? ' data-tsuzuri-document' : '').' href="'.attr_escape($_->{url}).'">'.html_escape($_->{title}).'</a></h2><p>'.html_escape($_->{description} || '').'</p></article>'} @$apps)
        . '</div></section>';
}

sub _site {
    my ($config) = @_;
    my $site = ref($config->{site}) eq 'HASH' ? $config->{site} : {};
    my $url = $site->{url} || $site->{base_url} || '';
    $url =~ s{/+$}{};
    return {
        title => $site->{title} || $site->{name} || 'Tsuzuri',
        name => $site->{name} || $site->{title} || 'Tsuzuri',
        description => $site->{description} || '',
        author => $site->{author} || '',
        language => $site->{language} || $site->{lang} || 'ja',
        url => $url,
    };
}

sub _cfg {
    my ($config, $path, $default) = @_;
    my $cursor = $config;
    for my $part (@$path) {
        return $default unless ref($cursor) eq 'HASH' && exists $cursor->{$part};
        $cursor = $cursor->{$part};
    }
    return $cursor;
}

sub _array {
    my ($value) = @_;
    return [] unless defined $value;
    return [@$value] if ref($value) eq 'ARRAY';
    return [$value];
}

sub _validate_config_schema {
    my ($config) = @_;
    die "Builder config must be a hash reference\n" unless ref($config) eq 'HASH';

    for my $section_name (qw(site build content theme standalone offline)) {
        next unless exists $config->{$section_name};
        die "Configuration section [$section_name] must be a section\n"
            unless ref($config->{$section_name}) eq 'HASH';
    }

    my $site = ref($config->{site}) eq 'HASH' ? $config->{site} : {};
    die "[site] url is required and must be a non-empty absolute HTTP(S) origin\n"
        unless exists $site->{url};
    _require_text($site->{url}, '[site] url', 0);
    _require_site_origin($site->{url}, '[site] url');
    for my $field (qw(name title description author language lang)) {
        _require_text($site->{$field}, "[site] $field", 1)
            if exists $site->{$field};
    }
    for my $field (qw(base_url)) {
        next unless exists $site->{$field};
        _require_text($site->{$field}, "[site] $field", 0);
        _require_site_origin($site->{$field}, "[site] $field");
    }

    my $build = ref($config->{build}) eq 'HASH' ? $config->{build} : {};
    _require_text($build->{output}, '[build] output', 0)
        if exists $build->{output};
    _require_text($build->{navigation}, '[build] navigation', 0)
        if exists $build->{navigation};
    _require_boolean($build->{clean}, '[build] clean')
        if exists $build->{clean};

    my $content = ref($config->{content}) eq 'HASH' ? $config->{content} : {};
    _require_integer($content->{posts_per_page}, '[content] posts_per_page', 1)
        if exists $content->{posts_per_page};
    _require_integer($content->{related_limit}, '[content] related_limit', 0)
        if exists $content->{related_limit};
    die "[content] allow_trusted_html is not supported; use trusted_html_sources\n"
        if exists $content->{allow_trusted_html};
    _trusted_html_source_map($config);

    my $theme = ref($config->{theme}) eq 'HASH' ? $config->{theme} : {};
    _require_text($theme->{path}, '[theme] path', 0) if exists $theme->{path};

    my $standalone = ref($config->{standalone}) eq 'HASH'
        ? $config->{standalone} : {};
    _require_text($standalone->{external_resources},
        '[standalone] external_resources', 0)
        if exists $standalone->{external_resources};
    if (exists $standalone->{external_resources}) {
        my $policy = lc($standalone->{external_resources});
        die "[standalone] external_resources must be allow, warn, or deny\n"
            unless $policy eq 'allow' || $policy eq 'warn' || $policy eq 'deny';
    }
    if (exists $standalone->{trusted_apps}) {
        die "[standalone] trusted_apps must be an array of strings\n"
            unless ref($standalone->{trusted_apps}) eq 'ARRAY';
        _require_text($_, '[standalone] trusted_apps entry', 0)
            for @{$standalone->{trusted_apps}};
    }

    my $offline = ref($config->{offline}) eq 'HASH' ? $config->{offline} : {};
    _require_boolean($offline->{enabled}, '[offline] enabled')
        if exists $offline->{enabled};
    return 1;
}

sub _validate_article_metadata {
    my ($meta, $source, $trusted_sources, $source_rel) = @_;
    die "$source: metadata must be a flat section\n" unless ref($meta) eq 'HASH';

    for my $field (qw(title slug summary route image category series id locale)) {
        _require_text($meta->{$field}, "$source: metadata '$field'", 1)
            if exists $meta->{$field};
    }
    for my $field (qw(created_at updated_at published_at date)) {
        _require_date($meta->{$field}, "$source: metadata '$field'")
            if exists $meta->{$field};
    }
    for my $field (qw(draft unlisted trusted_html)) {
        _require_boolean($meta->{$field}, "$source: metadata '$field'")
            if exists $meta->{$field};
    }
    for my $field (qw(tags categories aliases)) {
        next unless exists $meta->{$field};
        my $value = $meta->{$field};
        my @items = ref($value) eq 'ARRAY' ? @$value : ($value);
        die "$source: metadata '$field' must be a string or flat string array\n"
            if ref($value) && ref($value) ne 'ARRAY';
        _require_text($_, "$source: metadata '$field' entry", 0) for @items;
    }

    if ($meta->{trusted_html}) {
        my $normalized = _normalize_trusted_source_path($source_rel,
            "$source: trusted HTML source");
        die "$source: trusted_html = true requires exact source '$normalized' "
            . "in [content] trusted_html_sources\n"
            unless $trusted_sources->{$normalized};
    }
    return 1;
}

sub _trusted_html_source_map {
    my ($config) = @_;
    my $content = ref($config->{content}) eq 'HASH' ? $config->{content} : {};
    return {} unless exists $content->{trusted_html_sources};
    my $sources = $content->{trusted_html_sources};
    die "[content] trusted_html_sources must be an array of source paths\n"
        unless ref($sources) eq 'ARRAY';
    my %trusted;
    for my $source (@$sources) {
        my $normalized = _normalize_trusted_source_path($source,
            '[content] trusted_html_sources entry');
        die "[content] trusted_html_sources contains duplicate '$normalized'\n"
            if $trusted{$normalized}++;
    }
    return \%trusted;
}

sub _normalize_trusted_source_path {
    my ($path, $label) = @_;
    _require_text($path, $label, 0);
    die "$label must be a repository-relative forward-slash path\n"
        if File::Spec->file_name_is_absolute($path)
            || $path =~ m{\A/} || $path =~ /[\\:]/ || $path =~ m{//};
    my @parts = split('/', $path, -1);
    die "$label contains an unsafe dot or empty segment\n"
        if grep { !length($_) || $_ eq '.' || $_ eq '..' } @parts;
    die "$label must name a Markdown file below content/\n"
        unless @parts >= 2 && $parts[0] eq 'content' && $parts[-1] =~ /\.md\z/i;
    return join('/', @parts);
}

sub _validate_document_text {
    my ($text, $source) = @_;
    if ($text =~ /([\x00-\x08\x0B\x0C\x0E-\x1F\x7F\x{FFFE}\x{FFFF}])/) {
        die sprintf("%s: document contains forbidden control character U+%04X\n",
            $source, ord($1));
    }
    return 1;
}

sub _require_text {
    my ($value, $label, $allow_empty) = @_;
    die "$label must be a string\n"
        unless defined($value) && !ref($value)
            && (svref_2object(\$value)->FLAGS & SVf_POK);
    die "$label contains a control character or XML noncharacter\n"
        if $value =~ /[\x00-\x1F\x7F\x{FFFE}\x{FFFF}]/;
    die "$label must not be empty\n" unless $allow_empty || length($value);
    return $value;
}

sub _require_boolean {
    my ($value, $label) = @_;
    my $flags = defined($value) && !ref($value)
        ? svref_2object(\$value)->FLAGS : 0;
    die "$label must be true or false\n"
        unless ($flags & (SVf_IOK | SVf_NOK)) && !($flags & SVf_POK)
            && ($value == 0 || $value == 1);
    return $value ? 1 : 0;
}

sub _require_integer {
    my ($value, $label, $minimum) = @_;
    my $flags = defined($value) && !ref($value)
        ? svref_2object(\$value)->FLAGS : 0;
    die "$label must be an integer not less than $minimum\n"
        unless ($flags & (SVf_IOK | SVf_NOK)) && !($flags & SVf_POK)
            && int($value) == $value && $value >= $minimum;
    return $value;
}

sub _require_date {
    my ($value, $label) = @_;
    _require_text($value, $label, 0);
    die "$label must be YYYY-MM-DD or an RFC 3339 timestamp\n"
        unless defined rfc3339_epoch($value);
    return $value;
}

sub _require_site_origin {
    my ($value, $label) = @_;
    my $dns_label = qr{[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?};
    die "$label must be an absolute HTTP(S) origin without credentials, path, query, or fragment\n"
        unless $value =~ m{\Ahttps?://(?:$dns_label(?:\.$dns_label)*|\[[0-9A-Fa-f:.]+\])(?::([0-9]{1,5}))?/?\z}i;
    my $port = $1;
    die "$label port must be between 1 and 65535\n"
        if defined($port) && ($port < 1 || $port > 65535);
    return 1;
}

sub _filesystem_relative_url {
    my ($relative) = @_;
    my @encoded;
    for my $part (split('/', $relative, -1)) {
        my $text = $part;
        if (!utf8::is_utf8($text)) {
            my $bytes = $text;
            my $ok = eval {
                $text = decode('UTF-8', $bytes, FB_CROAK);
                1;
            };
            die "Published filesystem path is not valid UTF-8: $relative\n"
                unless $ok;
        }
        push @encoded, url_encode($text);
    }
    return join('/', @encoded);
}

sub _image_meta {
    my ($site, $image) = @_;
    return '' unless defined($image) && length($image);
    die "Metadata image must be a string\n" if ref($image);
    die "Metadata image contains an unsafe character\n" if $image =~ /[\x00-\x20\x7f]/;
    my $absolute;
    if ($image =~ m{\Ahttps?://}i) {
        $absolute = $image;
    } elsif ($image =~ m{\A/(?!/)}) {
        $absolute = ($site->{url} || '') . $image;
    } else {
        die "Metadata image must be an absolute HTTP(S) URL or a root-relative path\n";
    }
    return '<meta property="og:image" content="' . attr_escape($absolute) . '">';
}

sub _reserved_publication_route {
    my ($route) = @_;
    return 1 if $route eq '/assets/' || index($route, '/assets/') == 0;
    return 1 if $route eq '/_tsuzuri/' || index($route, '/_tsuzuri/') == 0;
    my @files = qw(
        /404.html /atom.xml /build.json /feed.json /manifest.webmanifest
        /robots.txt /routes.json /rss.xml /search-index.json
        /service-worker.js /sitemap.xml /.tsuzuri-generated
    );
    for my $file (@files) {
        return 1 if $route eq $file || index($route, $file . '/') == 0;
    }
    return 0;
}

sub _assert_child {
    my ($root, $path, $label) = @_;
    my $rel = File::Spec->abs2rel($path, $root);
    die "$label must stay within the site root\n"
        if $rel eq '..' || $rel =~ /^\.\.(?:[\\\/]|\z)/;
}

sub _assert_no_symlink_path {
    my ($root, $path, $label) = @_;
    my $relative = File::Spec->abs2rel($path, $root);
    my $current = $root;
    for my $part (File::Spec->splitdir($relative)) {
        next if !length($part) || $part eq '.';
        $current = File::Spec->catdir($current, $part);
        die "$label contains a symbolic-link component: $current\n" if -l $current;
        last unless -e $current;
    }
}

sub _validate_existing_output {
    my ($output) = @_;
    return unless -d $output;
    opendir my $dh, $output or die "Cannot inspect existing build output $output: $!\n";
    my @entries = grep { $_ ne '.' && $_ ne '..' } readdir($dh);
    closedir $dh;
    return unless @entries;
    my $marker = File::Spec->catfile($output, '.tsuzuri-generated');
    if (-f $marker && !-l $marker) {
        my $text = slurp_utf8($marker);
        return if $text =~ /^Tsuzuri generated output v1\n/;
    }
    die "Refusing to replace non-empty, unmarked output directory: $output\n";
}

sub _bundle_route_conflicts {
    my ($bundle, $generated) = @_;
    return 1 if $bundle eq $generated;
    return 1 if substr($bundle, -1) eq '/' && index($generated, $bundle) == 0;
    return 0;
}

sub _normalize_route {
    my ($route) = @_;
    $route = '/' unless defined($route) && length($route);
    die "Unsafe route contains control characters\n" if $route =~ /[\x00-\x1f]/;
    die "Unsafe route contains whitespace, a query, fragment, colon, or backslash\n"
        if $route =~ /[\s\\?#:]/;
    die "Unsafe route contains duplicate separators\n" if $route =~ m{//};
    die "Unsafe route contains unsupported characters\n"
        unless $route =~ m{\A/[A-Za-z0-9._~%/-]*\z};
    die "Unsafe route contains a dot segment\n" if $route =~ m{/(?:\.|\.\.)(?:/|\z)};
    $route =~ s{/+\z}{} unless $route eq '/';
    $route = normalize_route($route);
    return route_path_info($route, label => 'Unsafe route')->{route};
}

sub _validate_internal_links {
    my ($stage, $articles) = @_;
    my @broken;
    for my $article (@$articles) {
        my @links = @{$article->{links} || []};
        push @links, {url => $article->{image}}
            if defined($article->{image}) && length($article->{image});
        for my $link (@links) {
            my $url = ref($link) eq 'HASH' ? ($link->{url} || '') : $link;
            next unless defined($url) && $url =~ m{^/} && $url !~ m{^//};
            $url =~ s/[?#].*\z//;
            next unless length $url;
            my $route = eval { _normalize_route($url) };
            if (!$route) {
                push @broken, "$article->{source_rel}: unsafe internal URL $url";
                next;
            }
            my @parts = @{route_path_info($route,
                label => "Internal URL $url")->{parts}};
            my $path = $route =~ /\.[A-Za-z0-9]+\z/
                ? File::Spec->catfile($stage, @parts)
                : File::Spec->catfile($stage, @parts, 'index.html');
            push @broken, "$article->{source_rel}: $url" unless -f $path;
        }
    }
    die "Broken internal link(s):\n  " . join("\n  ", @broken) . "\n" if @broken;
    return 1;
}

sub _write_route {
    my ($stage, $route, $html) = @_;
    my @parts = @{route_path_info($route,
        label => "Generated route $route")->{parts}};
    my $path;
    if ($route =~ /\.[A-Za-z0-9]+\z/) {
        $path = File::Spec->catfile($stage, @parts);
    } else {
        $path = File::Spec->catfile($stage, @parts, 'index.html');
    }
    die "Generated route $route conflicts with an existing static file\n" if -e $path;
    write_utf8($path, $html);
}

sub _write_generated_file {
    my ($stage, $relative, $text) = @_;
    die "Generated file path is unsafe: $relative\n"
        if !defined($relative) || File::Spec->file_name_is_absolute($relative)
        || $relative =~ m{(?:^|[\\/])\.\.(?:[\\/]|$)};
    my $path = File::Spec->catfile($stage, $relative);
    die "Generated file $relative conflicts with an existing static file\n" if -e $path;
    write_utf8($path, $text);
}

sub _copy_assets {
    my ($source, $destination) = @_;
    return 0 unless -d $source;
    my $count = 0;
    for my $path (@{list_files($source)}) {
        die "Theme asset may not be a symbolic link: $path\n" if -l $path;
        my $rel = File::Spec->abs2rel($path, $source);
        _assert_child($source, $path, 'asset');
        my $dest = File::Spec->catfile($destination, $rel);
        die "Asset $path conflicts with existing output $dest\n" if -e $dest;
        mkpath(dirname($dest)) unless -d dirname($dest);
        copy($path, $dest) or die "Could not copy $path to $dest: $!\n";
        $count++;
    }
    return $count;
}

sub _copy_missing_assets {
    my ($source, $destination) = @_;
    return 0 unless -d $source;
    my $count = 0;
    for my $path (@{list_files($source)}) {
        die "Preserved output may not be a symbolic link: $path\n" if -l $path;
        my $rel = File::Spec->abs2rel($path, $source);
        my $portable = $rel;
        $portable =~ tr{\\}{/};
        next if $portable eq 'build.json'
            || $portable eq '.tsuzuri-generated'
            || $portable eq '_tsuzuri/sw-manifest.json'
            || $portable eq 'service-worker.js';
        _assert_child($source, $path, 'preserved output');
        my $dest = File::Spec->catfile($destination, $rel);
        next if -e $dest;
        mkpath(dirname($dest)) unless -d dirname($dest);
        copy($path, $dest) or die "Could not preserve $path as $dest: $!\n";
        $count++;
    }
    return $count;
}

1;

__END__

=head1 NAME

Tsuzuri::Builder - deterministic, all-static site builder

=head1 SYNOPSIS

  my $builder = Tsuzuri::Builder->new(root => '.', config => $config);
  my $stats = $builder->build;

=head1 DESCRIPTION

C<build> scans C<content/**/*.md>, parses front matter and Markdown, builds the
content graph, renders the complete site into a staging directory, and only
then replaces the configured output directory.  It emits full HTML for every
route along with feeds, taxonomies, a Japanese-aware search index, sitemap,
robots file, route manifest, and copied theme/site assets.  C<document>, C<spa>,
and C<hybrid> navigation modes all retain directly addressable static files.

When C<standalone/> exists, its raw, framed, and integrated bundles are scanned
through L<Tsuzuri::Standalone>, checked for route collisions, and published in
the same transaction.

=head1 CONFIGURATION

Recognized nested sections include C<[site]> (name/title, url, description,
author, language), C<[build]> (output, navigation), C<[content]>
(posts_per_page, related_limit), C<[theme]> (path), and C<[standalone]>
(external_resources, trusted_apps).

=cut

