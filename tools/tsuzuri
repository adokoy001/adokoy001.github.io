    my ($line) = @_;
    return 1 if $line =~ /^ {0,3}(?:\*[ \t]*){3,}$/;
    return 1 if $line =~ /^ {0,3}(?:-[ \t]*){3,}$/;
    return 1 if $line =~ /^ {0,3}(?:_[ \t]*){3,}$/;
