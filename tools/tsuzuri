sub _table_separator {
    my ($line) = @_;
    return unless _looks_like_table_row($line);
    my @cells = _split_table_row($line);
    return unless @cells;
    my @align;
    for my $cell (@cells) {
        return unless $cell =~ /^(:)?-{3,}(:)?$/;
        push @align, $1 && $2 ? 'center' : $1 ? 'left' : $2 ? 'right' : '';
