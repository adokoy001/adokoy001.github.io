    my $clean = $url;
    $clean =~ s/^\s+//;
    $clean =~ s/\s+$//;
    return if $clean =~ /[\x00-\x20\x7F]/;
    if ($clean =~ /^([A-Za-z][A-Za-z0-9+.-]*):/) {
        my $scheme = lc($1);
        return unless $scheme eq 'http' || $scheme eq 'https' || (!$image && ($scheme eq 'mailto' || $scheme eq 'tel'));
    } elsif ($clean =~ m{^//}) {
        # Scheme-relative web resources are safe in this context.
    }
