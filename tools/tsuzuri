    return ($url, $title);
}

sub _find_unescaped {
    my ($text, $marker, $start) = @_;
    my $at = $start;
    while (1) {
        $at = index($text, $marker, $at);
        return -1 if $at < 0;
        my $slashes = 0;
        for (my $i = $at - 1; $i >= 0 && substr($text, $i, 1) eq '\\'; $i--) { $slashes++; }
        return $at if $slashes % 2 == 0;
        $at += length($marker);
    }
}

sub _safe_url {
    my ($url, $image) = @_;
