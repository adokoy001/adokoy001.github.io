package Tsuzuri::CLI;

use 5.010;
use strict;
use warnings;
use utf8;
use Encode qw(encode);
use File::Spec;
use FindBin;
use Tsuzuri;
use Tsuzuri::Util qw(atomic_write ensure_dir slugify now_iso);

sub run {
    my ($class, @argv) = @_;
    my $command = shift(@argv) || 'help';
    my ($opt, $args, $root);
    my $ok = eval {
        ($opt, $args) = _options(@argv);
        $root = File::Spec->rel2abs($opt->{root} || '.');
        if ($command eq 'help' || $command eq '--help' || $command eq '-h') {
            print _help();
        } elsif ($command eq 'version' || $command eq '--version') {
            print "Tsuzuri $Tsuzuri::VERSION (Perl $])\n";
        } elsif ($command eq 'init') {
            $class->_init($root, $opt);
        } elsif ($command eq 'new') {
            $class->_new($root, $opt, $args);
        } elsif ($command eq 'build') {
            my $result = $class->_build($root, $opt);
            _print_result('Build complete', $result);
        } elsif ($command eq 'check') {
            my %copy = %$opt;
            $copy{check} = 1;
            my $result = $class->_build($root, \%copy);
            _print_result('Check complete', $result);
        } elsif ($command eq 'doctor') {
            $class->_doctor($root);
        } elsif ($command eq 'serve') {
            $class->_serve($root, $opt);
        } elsif ($command eq 'migrate-nikki' || ($command eq 'migrate' && @$args && $args->[0] eq 'nikki')) {
            shift @$args if $command eq 'migrate';
            $class->_migrate_nikki($root, $opt, $args);
        } else {
            die "Unknown command: $command\n\n" . _help();
        }
        1;
    };
    if (!$ok) {
        my $error = $@ || "Unknown error\n";
        print STDERR encode('UTF-8', "Tsuzuri: $error");
        return 1;
    }
    return 0;
}

sub _init {
    my ($class, $root, $opt) = @_;
    ensure_dir($root);
    for my $dir (qw(content content/posts content/pages standalone static themes public .tsuzuri)) {
        ensure_dir(File::Spec->catdir($root, split('/', $dir)));
    }
    my $config = File::Spec->catfile($root, 'tsuzuri.conf');
    if (!-e $config || $opt->{force}) {
        atomic_write($config, <<'CONF');
# Tsuzuri site configuration
[site]
name = "My Tsuzuri Site"
description = "A dependency-free static site"
url = "http://localhost:4173"
author = "Author"
language = "en"

[build]
output = "public"
navigation = "hybrid"
clean = true

[content]
posts_per_page = 10
related_limit = 5
trusted_html_sources = []

[standalone]
external_resources = "warn"
trusted_apps = []
CONF
    }
    my $first = File::Spec->catfile($root, 'content', 'posts', 'welcome.md');
    if (!-e $first || $opt->{force}) {
        atomic_write($first, <<'MARKDOWN');
---
title = "Welcome to Tsuzuri"
slug = "welcome"
summary = "Your dependency-free publishing engine is ready."
created_at = "2026-01-01T00:00:00Z"
tags = ["Tsuzuri", "Perl"]
draft = false
---

# Welcome to Tsuzuri

This site is generated using **Pure Perl** and browser standards. No CPAN,
Node.js, database, or client framework is required.

## Next steps

- Run `perl tsuzuri new post --title="My article"`.
- Run `perl tsuzuri serve` for local editing and preview.
- Put complete HTML applications under `standalone/`.
MARKDOWN
    }
    my $ignore = File::Spec->catfile($root, '.gitignore');
    if (!-e $ignore || $opt->{force}) {
        atomic_write($ignore, "public/\n.tsuzuri/\n*.tmp\n");
    }
    print "Initialized Tsuzuri site at $root\n";
}

sub _new {
    my ($class, $root, $opt, $args) = @_;
    my $kind = shift(@$args) || 'post';
    die "Content type must be post or page\n" unless $kind eq 'post' || $kind eq 'page';
    my $title = $opt->{title} || join(' ', @$args) || 'Untitled';
    die "Title contains a control character\n" if $title =~ /[\x00-\x1f\x7f]/;
    die "Title is too long (maximum 500 characters)\n" if length($title) > 500;
    my $slug;
    if (defined($opt->{slug}) && length($opt->{slug})) {
        die "Slug must contain lowercase ASCII letters, digits, and single hyphens only\n"
            unless $opt->{slug} =~ /\A[a-z0-9]+(?:-[a-z0-9]+)*\z/;
        $slug = $opt->{slug};
    } else {
        $slug = slugify($title);
    }
    my @local = localtime(time);
    my $date = now_iso();
    my $dir = $kind eq 'post'
        ? File::Spec->catdir($root, 'content', 'posts', sprintf('%04d', $local[5]+1900), sprintf('%02d', $local[4]+1))
        : File::Spec->catdir($root, 'content', 'pages');
    ensure_dir($dir);
    my $path = File::Spec->catfile($dir, $slug . '.md');
    die "Content already exists: $path\n" if -e $path;
    my $draft = $opt->{draft} ? 'true' : 'false';
    my $safe_title = $title;
    $safe_title =~ s/\\/\\\\/g;
    $safe_title =~ s/\"/\\\"/g;
    atomic_write($path, qq{---\ntitle = "$safe_title"\nslug = "$slug"\nsummary = ""\ncreated_at = "$date"\ntags = []\ndraft = $draft\n---\n\n# $title\n\nWrite here.\n});
    print "$path\n";
}

sub _builder {
    my ($class, $root, $opt) = @_;
    require Tsuzuri::Builder;
    return Tsuzuri::Builder->new(
        root => $root,
        output => $opt->{output},
        navigation => $opt->{navigation},
        check => $opt->{check},
        verbose => $opt->{verbose},
    );
}

sub _build {
    my ($class, $root, $opt) = @_;
    my $builder = $class->_builder($root, $opt);
    return $builder->build();
}

sub _serve {
    my ($class, $root, $opt) = @_;
    my $result = $class->_build($root, $opt);
    _print_result('Initial build complete', $result);
    require Tsuzuri::HTTP;
    my $output = $result->{output}
        || File::Spec->catdir($root, $opt->{output} || 'public');
    my $server = Tsuzuri::HTTP->new(
        root => $output,
        site_root => $root,
        host => $opt->{host} || '127.0.0.1',
        port => $opt->{port} || 4173,
        admin_root => $ENV{TSUZURI_SHARE_DIR}
            ? File::Spec->catdir($ENV{TSUZURI_SHARE_DIR}, 'admin')
            : File::Spec->catdir($FindBin::Bin, 'share', 'admin'),
        build => sub { return $class->_build($root, $opt) },
    );
    return $server->serve_forever();
}

sub _migrate_nikki {
    my ($class, $root, $opt, $args) = @_;
    my $source = $opt->{from} || shift(@$args) or die "Usage: tsuzuri migrate-nikki --from=/path/to/nikki\n";
    require Tsuzuri::Migrate::Nikki;
    $class->_init($root, {}) unless -f File::Spec->catfile($root, 'tsuzuri.conf');
    my %extra;
    $extra{timezone} = $opt->{timezone} if defined $opt->{timezone};
    my $migrator = Tsuzuri::Migrate::Nikki->new(source => File::Spec->rel2abs($source), destination => $root, %extra);
    my $result = $migrator->run();
    print "Migrated $result->{count} entries.\nReport: $result->{report}\n";
}

sub _doctor {
    my ($class, $root) = @_;
    my @checks;
    push @checks, [ 'Perl version >= 5.10', $] >= 5.010 ? 1 : 0, $] ];
    my @modules = (
        [ 'B', sub { require B } ],
        [ 'Cwd', sub { require Cwd } ],
        [ 'Digest::SHA', sub { require Digest::SHA } ],
        [ 'Encode', sub { require Encode } ],
        [ 'File::Copy', sub { require File::Copy } ],
        [ 'File::Find', sub { require File::Find } ],
        [ 'File::Spec', sub { require File::Spec } ],
        [ 'File::Path', sub { require File::Path } ],
        [ 'File::Temp', sub { require File::Temp } ],
        [ 'Getopt::Long', sub { require Getopt::Long } ],
        [ 'IO::Socket::INET', sub { require IO::Socket::INET } ],
        [ 'POSIX', sub { require POSIX } ],
        [ 'Storable', sub { require Storable } ],
        [ 'Time::Local', sub { require Time::Local } ],
    );
    for my $entry (@modules) {
        my ($module, $loader) = @$entry;
        my $ok = eval { $loader->(); 1 };
        push @checks, [ "core module $module", $ok ? 1 : 0, $ok ? 'available' : $@ ];
    }
    my $has_config = -f File::Spec->catfile($root, 'tsuzuri.conf');
    push @checks, [ 'site initialization', 1,
        $has_config ? "tsuzuri.conf found in $root" : 'no site selected (run init to create one)' ];
    my $failed = 0;
    for my $check (@checks) {
        my ($name, $ok, $detail) = @$check;
        print(($ok ? '[OK]   ' : '[FAIL] ') . "$name - $detail\n");
        $failed++ unless $ok;
    }
    die "$failed doctor check(s) failed\n" if $failed;
    print "No CPAN installation is required.\n";
    return 1;
}

sub _options {
    my (@argv) = @_;
    my %opt;
    my %known = map { $_ => 1 } qw(
        root force title slug draft navigation output host port from timezone verbose
    );
    my @args;
    while (@argv) {
        my $arg = shift @argv;
        if ($arg =~ /^--no-(.+)$/) {
            die "Unknown option: --no-$1\n" unless $known{$1};
            $opt{$1} = 0;
        } elsif ($arg =~ /^--([^=]+)=(.*)$/s) {
            die "Unknown option: --$1\n" unless $known{$1};
            $opt{$1} = $2;
        } elsif ($arg =~ /^--(.+)$/) {
            my $key = $1;
            die "Unknown option: --$key\n" unless $known{$key};
            if (@argv && $argv[0] !~ /^-/ && $key =~ /^(?:root|title|slug|navigation|output|host|port|from|timezone)$/) {
                $opt{$key} = shift @argv;
            } else {
                $opt{$key} = 1;
            }
        } else {
            push @args, $arg;
        }
    }
    return (\%opt, \@args);
}

sub _print_result {
    my ($label, $result) = @_;
    if ($result && ref($result) eq 'HASH') {
        my @parts;
        for my $key (qw(pages posts files apps warnings elapsed)) {
            push @parts, "$key=$result->{$key}" if defined $result->{$key} && !ref($result->{$key});
        }
        print "$label" . (@parts ? ': ' . join(', ', @parts) : '') . "\n";
    } else {
        print "$label\n";
    }
}

sub _help {
    return <<'HELP';
Tsuzuri - Pure Perl static publishing

Usage:
  perl tsuzuri init [--root=DIR]
  perl tsuzuri new post|page --title="Title" [--draft]
  perl tsuzuri build [--navigation=document|spa|hybrid]
  perl tsuzuri serve [--host=127.0.0.1] [--port=4173]
  perl tsuzuri check
  perl tsuzuri doctor
  perl tsuzuri migrate-nikki --from=/path/to/nikki [--timezone=+09:00]
  perl tsuzuri version

No CPAN, Node.js, database, or build framework is required.
HELP
}

1;

__END__

