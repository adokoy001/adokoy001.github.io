    my $escaped = 0;
    my $code = 0;
    for (my $i = 0; $i < length($line); $i++) {
        my $c = substr($line, $i, 1);
        if ($escaped) { $cell .= $c; $escaped = 0; next; }
        if ($c eq '\\') { $cell .= $c; $escaped = 1; next; }
        if ($c eq '`') { $code = !$code; $cell .= $c; next; }
        if ($c eq '|' && !$code) { push @cells, _trim($cell); $cell = ''; next; }
        $cell .= $c;
    }
    push @cells, _trim($cell);
    return @cells;
