package Tsuzuri::Feed;

use 5.010;
use strict;
use warnings;
use utf8;
use Tsuzuri::Util qw(rfc3339_epoch xml_escape);
use Tsuzuri::Search ();

sub rss {
    my ($class, $articles, %opt) = @_;
    _articles($articles);
    my $site = _site(\%opt);
    my @items;
    for my $article (_feed_articles($articles, $opt{limit})) {
        my $url = _absolute($site->{base_url}, $article->{url} || $article->{route});
        my $date = _date($article);
        push @items, join('',
            "    <item>\n",
            '      <title>', xml_escape($article->{title}), "</title>\n",
            '      <link>', xml_escape($url), "</link>\n",
            '      <guid isPermaLink="true">', xml_escape($url), "</guid>\n",
            '      <pubDate>', xml_escape(_rfc822($date)), "</pubDate>\n",
            '      <description>', xml_escape($article->{summary} || ''), "</description>\n",
            '      <content:encoded>', xml_escape($article->{html} || ''), "</content:encoded>\n",
            "    </item>\n",
        );
    }
    my $home = _absolute($site->{base_url}, '/');
    return join('',
        qq{<?xml version="1.0" encoding="UTF-8"?>\n},
        qq{<rss version="2.0" xmlns:content="http://purl.org/rss/1.0/modules/content/">\n},
        "  <channel>\n",
        '    <title>', xml_escape($site->{title}), "</title>\n",
        '    <link>', xml_escape($home), "</link>\n",
        '    <description>', xml_escape($site->{description}), "</description>\n",
        '    <language>', xml_escape($site->{language}), "</language>\n",
        @items,
        "  </channel>\n",
        "</rss>\n",
    );
}

sub atom {
    my ($class, $articles, %opt) = @_;
    _articles($articles);
    my $site = _site(\%opt);
    my $home = _absolute($site->{base_url}, '/');
    my $feed_url = _absolute($site->{base_url}, $opt{feed_path} || '/atom.xml');
    my @selected = _feed_articles($articles, $opt{limit});
    my $updated = '1970-01-01T00:00:00Z';
    if (@selected) {
        my @updates = map { $_->{updated_at} || _date($_) } @selected;
        @updates = sort {
            _date_epoch($b) <=> _date_epoch($a) || $a cmp $b
        } @updates;
        $updated = $updates[0];
    }
    my @entries;
    for my $article (@selected) {
        my $url = _absolute($site->{base_url}, $article->{url} || $article->{route});
        my $date = _date($article);
        push @entries, join('',
            "  <entry>\n",
            '    <title>', xml_escape($article->{title}), "</title>\n",
            '    <id>', xml_escape($url), "</id>\n",
            '    <link rel="alternate" href="', xml_escape($url), "\" />\n",
            '    <published>', xml_escape(_iso($date)), "</published>\n",
            '    <updated>', xml_escape(_iso($article->{updated_at} || $date)), "</updated>\n",
            '    <summary>', xml_escape($article->{summary} || ''), "</summary>\n",
            '    <content type="html">', xml_escape($article->{html} || ''), "</content>\n",
            "  </entry>\n",
        );
    }
    return join('',
        qq{<?xml version="1.0" encoding="UTF-8"?>\n},
        qq{<feed xmlns="http://www.w3.org/2005/Atom">\n},
        '  <title>', xml_escape($site->{title}), "</title>\n",
        '  <id>', xml_escape($home), "</id>\n",
        '  <link rel="alternate" href="', xml_escape($home), "\" />\n",
        '  <link rel="self" href="', xml_escape($feed_url), "\" />\n",
        '  <updated>', xml_escape(_iso($updated)), "</updated>\n",
        @entries,
        "</feed>\n",
    );
}

sub json_feed {
    my ($class, $articles, %opt) = @_;
    _articles($articles);
    my $site = _site(\%opt);
    my @items;
    for my $article (_feed_articles($articles, $opt{limit})) {
        my $url = _absolute($site->{base_url}, $article->{url} || $article->{route});
        my @tags = ref($article->{tags}) eq 'ARRAY' ? @{$article->{tags}} : ();
        push @items, {
            id             => defined($article->{id}) ? $article->{id} : $url,
            url            => $url,
            title          => defined($article->{title}) ? $article->{title} : '',
            summary        => defined($article->{summary}) ? $article->{summary} : '',
            content_html   => defined($article->{html}) ? $article->{html} : '',
            date_published => _iso(_date($article)),
            date_modified  => _iso($article->{updated_at} || _date($article)),
            tags           => \@tags,
        };
    }
    return Tsuzuri::Search->encode_json({
        version       => 'https://jsonfeed.org/version/1.1',
        title         => $site->{title},
        home_page_url => _absolute($site->{base_url}, '/'),
        feed_url      => _absolute($site->{base_url}, $opt{feed_path} || '/feed.json'),
        description   => $site->{description},
        language      => $site->{language},
        items         => \@items,
    }, pretty => 1) . "\n";
}

sub sitemap {
    my ($class, $routes, %opt) = @_;
    die "Tsuzuri::Feed->sitemap expects an array reference\n"
        unless ref($routes) eq 'ARRAY';
    my $site = _site(\%opt);
    my @rows;
    my %seen;
    for my $row (sort {
        (ref($a) ? ($a->{route} || $a->{url} || '') : $a)
            cmp (ref($b) ? ($b->{route} || $b->{url} || '') : $b)
    } @$routes) {
        my ($route, $lastmod) = ref($row) eq 'HASH'
            ? ($row->{url} || $row->{route}, $row->{updated_at} || $row->{date})
            : ($row, undef);
        next unless defined($route) && length($route);
        next if $seen{$route}++;
        push @rows, "  <url>\n";
        push @rows, '    <loc>', xml_escape(_absolute($site->{base_url}, $route)), "</loc>\n";
        push @rows, '    <lastmod>', xml_escape(_iso($lastmod)), "</lastmod>\n"
            if defined($lastmod) && length($lastmod);
        push @rows, "  </url>\n";
    }
    return join('',
        qq{<?xml version="1.0" encoding="UTF-8"?>\n},
        qq{<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n},
        @rows,
        "</urlset>\n",
    );
}

sub robots {
    my ($class, %opt) = @_;
    my $site = _site(\%opt);
    return "User-agent: *\nAllow: /\nSitemap: "
        . _absolute($site->{base_url}, $opt{sitemap_path} || '/sitemap.xml') . "\n";
}

sub _articles {
    my ($articles) = @_;
    die "Feed articles must be an array reference\n" unless ref($articles) eq 'ARRAY';
}

sub _site {
    my ($opt) = @_;
    my $input = ref($opt->{site}) eq 'HASH' ? $opt->{site} : {};
    my $base = defined($opt->{base_url}) ? $opt->{base_url}
        : defined($input->{base_url}) ? $input->{base_url}
        : defined($input->{url}) ? $input->{url} : '';
    $base =~ s{/+$}{};
    return {
        title       => $input->{title} || $input->{name} || 'Tsuzuri',
        description => $input->{description} || '',
        language    => $input->{language} || $input->{lang} || 'ja',
        base_url    => $base,
    };
}

sub _feed_articles {
    my ($articles, $limit) = @_;
    $limit = 20 unless defined($limit) && $limit =~ /^\d+$/;
    my @items = grep { !$_->{draft} && !$_->{unlisted} } @$articles;
    @items = sort {
        _date_epoch(_date($b)) <=> _date_epoch(_date($a))
            || ($a->{route} || '') cmp ($b->{route} || '')
    } @items;
    splice @items, $limit if @items > $limit;
    return @items;
}

sub _date {
    my ($article) = @_;
    return $article->{published_at} || $article->{date}
        || $article->{created_at} || '1970-01-01T00:00:00Z';
}

sub _iso {
    my ($date) = @_;
    return '1970-01-01T00:00:00Z' unless defined($date) && length($date);
    die "Invalid feed date '$date'\n" unless defined rfc3339_epoch($date);
    return $date . 'T00:00:00Z' if $date =~ /^\d{4}-\d\d-\d\d$/;
    return $date;
}

sub _rfc822 {
    my ($date) = @_;
    my $epoch = _date_epoch($date);
    my @utc = gmtime($epoch);
    die "Feed date '$date' is outside this platform's UTC conversion range\n"
        unless @utc >= 9;
    my @weekday = qw(Sun Mon Tue Wed Thu Fri Sat);
    my @month = qw(Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec);
    return sprintf('%s, %02d %s %04d %02d:%02d:%02d GMT',
        $weekday[$utc[6]], $utc[3], $month[$utc[4]], $utc[5] + 1900,
        $utc[2], $utc[1], $utc[0]);
}

sub _date_epoch {
    my ($date) = @_;
    my $epoch = rfc3339_epoch($date);
    die "Invalid feed date '$date'\n" unless defined $epoch;
    return $epoch;
}

sub _absolute {
    my ($base, $route) = @_;
    $route = '/' unless defined($route) && length($route);
    return $route if $route =~ m{^https?://}i;
    $route = '/' . $route unless $route =~ m{^/};
    return $base . $route;
}

1;

__END__

=head1 NAME

Tsuzuri::Feed - RSS, Atom, JSON Feed, sitemap, and robots generators

=head1 SYNOPSIS

  my $rss = Tsuzuri::Feed->rss(\@articles, site => \%site);
  my $map = Tsuzuri::Feed->sitemap(\@routes, site => \%site);

=head1 DESCRIPTION

All methods return UTF-8 character strings and sort their input deterministically.
No wall-clock build timestamp is emitted; feed timestamps come from content, so
rebuilding unchanged sources produces identical output.

=cut

