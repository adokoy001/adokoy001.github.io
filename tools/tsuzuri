    return $count == 1 ? $base : $base . '-' . $count;
}

sub _charge {
    my ($budget, $amount) = @_;
    $budget->{operations} += $amount > 0 ? $amount : 0;
    die "Markdown inline processing limit exceeded\n"
        if $budget->{operations} > $budget->{limit};
