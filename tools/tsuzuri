    return 1 if $line =~ /^ {0,3}(?:#{1,6})(?:\s|$)/;
    return 1 if $line =~ /^ {0,3}(?:`{3,}|~{3,})/;
    return 1 if $line =~ /^ {0,3}:::trusted-html[ \t]*$/;
    return 1 if $line =~ /^ {0,3}>/;
    return 1 if $line =~ /^ {0,3}\[\^[^\]]+\]:/;
    return 1 if _is_horizontal_rule($line);
    my @list_match = _list_match($line);
    return 1 if @list_match;
    return 1 if $line =~ /^(?: {4}|\t)/;
    return 0;
