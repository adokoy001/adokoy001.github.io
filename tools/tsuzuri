#!/usr/bin/env perl

use 5.010;
use strict;
use warnings;
use File::Basename qw(dirname);
use File::Path qw(mkpath);
use File::Spec;
use File::Temp qw(tempdir);

my (%TSUZURI_MODULE, %TSUZURI_ASSET);
_tsuzuri_read_archive();

unshift @INC, sub {
    my ($hook, $filename) = @_;
    return unless exists $TSUZURI_MODULE{$filename};
    my $source = $TSUZURI_MODULE{$filename};
    open my $fh, '<', \$source or die "Cannot open bundled module $filename: $!\n";
    binmode $fh;
    return $fh;
};

my $TSUZURI_TEMP = tempdir('tsuzuri-XXXXXXXX', TMPDIR => 1, CLEANUP => 1);
my $TSUZURI_SHARE = File::Spec->catdir($TSUZURI_TEMP, 'share');
mkpath($TSUZURI_SHARE);
for my $name (sort keys %TSUZURI_ASSET) {
    die "Unsafe bundled asset path: $name\n" unless _tsuzuri_safe_path($name);
    my @parts = split('/', $name);
    my $destination = File::Spec->catfile($TSUZURI_SHARE, @parts);
    my $parent = dirname($destination);
    mkpath($parent) unless -d $parent;
    open my $fh, '>', $destination or die "Cannot extract bundled asset $name: $!\n";
    binmode $fh;
    print {$fh} $TSUZURI_ASSET{$name} or die "Cannot extract bundled asset $name: $!\n";
    close $fh or die "Cannot close bundled asset $name: $!\n";
}

$ENV{TSUZURI_SHARE_DIR} = $TSUZURI_SHARE;
$ENV{TSUZURI_BUNDLED} = 1;
require Tsuzuri::CLI;
exit Tsuzuri::CLI->run(@ARGV);

sub _tsuzuri_read_archive {
    binmode DATA;
    my $magic = <DATA>;
    die "Invalid Tsuzuri bundle header\n"
        unless defined($magic) && $magic eq "TSUZURI_BUNDLE_V1\n";
    while (1) {
        my $header = <DATA>;
        die "Truncated Tsuzuri bundle\n" unless defined $header;
        $header =~ s/\n\z//;
        last if $header eq 'E';
        my ($type, $name, $length) = split(/\t/, $header, 3);
        die "Invalid Tsuzuri bundle record\n"
            unless defined($type) && ($type eq 'M' || $type eq 'A')
                && _tsuzuri_safe_path($name)
                && defined($length) && $length =~ /\A\d+\z/;
        my $bytes = '';
        my $remaining = 0 + $length;
        while ($remaining > 0) {
            my $read = read(DATA, my $chunk, $remaining);
            die "Could not read Tsuzuri bundle record $name: $!\n" unless defined $read;
            die "Truncated Tsuzuri bundle record $name\n" if $read == 0;
            $bytes .= $chunk;
            $remaining -= $read;
        }
        my $separator = '';
        my $read = read(DATA, $separator, 1);
        die "Invalid Tsuzuri bundle record separator\n"
            unless defined($read) && $read == 1 && $separator eq "\n";
        if ($type eq 'M') {
            die "Duplicate bundled module: $name\n" if exists $TSUZURI_MODULE{$name};
            $TSUZURI_MODULE{$name} = $bytes;
        } else {
            die "Duplicate bundled asset: $name\n" if exists $TSUZURI_ASSET{$name};
            $TSUZURI_ASSET{$name} = $bytes;
        }
    }
}

sub _tsuzuri_safe_path {
    my ($path) = @_;
    return 0 unless defined($path) && length($path);
    return 0 if $path =~ /[\r\n\t\\]/;
    return 0 if $path =~ m{(?:\A|/)\.{1,2}(?:/|\z)};
    return 0 if $path =~ m{//};
    return 1;
}

