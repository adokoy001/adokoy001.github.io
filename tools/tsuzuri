package Tsuzuri::HTTP;

use 5.010;
use strict;
use warnings;
use utf8;
use Encode qw(decode encode FB_CROAK FB_DEFAULT);
use IO::Socket::INET;
use File::Spec;
use Tsuzuri::Util qw(slurp_utf8 atomic_write json_encode list_files safe_join);
use Digest::SHA qw(sha256_hex);

sub new {
    my ($class, %arg) = @_;
    my $host = $arg{host} || '127.0.0.1';
    # IO::Socket::INET is available in the Perl 5.10 core but is IPv4-only.
    # Do not advertise ::1 here: accepting it would pass validation and fail
    # only later at bind time on an otherwise supported installation.
    die "Preview server host must be 127.0.0.1 or localhost\n"
        unless _is_loopback_host($host);
    my $port = defined($arg{port}) ? $arg{port} : 4173;
    die "Preview server port must be an integer from 1 to 65535\n"
        unless $port =~ /^\d+$/ && $port >= 1 && $port <= 65535;
    my $max_request = defined($arg{max_request}) ? $arg{max_request} : 5 * 1024 * 1024;
    die "Maximum request size must be a positive integer\n"
        unless $max_request =~ /^\d+$/ && $max_request > 0;
    my $self = bless {
        root => $arg{root} || '.',
        site_root => $arg{site_root} || '.',
        host => $host,
        port => 0 + $port,
        build => $arg{build},
        admin_root => $arg{admin_root},
        max_request => 0 + $max_request,
    }, $class;
    $self->{token} = _new_token($self->{root});
    return $self;
}

sub token { return $_[0]->{token}; }

sub serve_forever {
    my ($self) = @_;
    my $server = IO::Socket::INET->new(
        LocalAddr => $self->{host},
        LocalPort => $self->{port},
        Proto => 'tcp',
        Listen => 16,
        ReuseAddr => 1,
    ) or die "Cannot start preview server: $!\n";
    print "Tsuzuri preview: http://$self->{host}:$self->{port}/\n";
    print "Editor: http://$self->{host}:$self->{port}/__tsuzuri/?token=$self->{token}\n";
    print "Press Ctrl-C to stop.\n";
    local $SIG{PIPE} = 'IGNORE';
    while (my $client = $server->accept) {
        eval { $self->_handle($client) };
        if ($@) {
            eval { $self->_respond($client, 500, 'text/plain; charset=utf-8', "Internal error\n") };
            warn $@;
        }
        close $client;
    }
    return 0;
}

sub _handle {
    my ($self, $client) = @_;
    $client->autoflush(1);
    my $request = <$client>;
    return unless defined $request;
    $request =~ s/[\r\n]+$//;
    my ($method, $target, $version) = split /\s+/, $request, 3;
    return $self->_respond($client, 400, 'text/plain', 'Bad request')
        unless $method && $target && $version && $version =~ m{^HTTP/1\.[01]$};
    my %headers;
    my $header_error = '';
    while (defined(my $line = <$client>)) {
        $line =~ s/[\r\n]+$//;
        last unless length $line;
        if ($line !~ /^([!#-'*+\-.0-9A-Z\^_`a-z|~]+):[ \t]*(.*)$/) {
            $header_error = 'Malformed header';
            next;
        }
        my ($name, $value) = (lc($1), $2);
        if (exists $headers{$name}) {
            $header_error = 'Duplicate header';
            next;
        }
        $headers{$name} = $value;
    }
    return $self->_respond($client, 400, 'text/plain', $header_error) if length $header_error;
    return $self->_respond($client, 400, 'text/plain', 'Invalid request target')
        unless $target =~ m{^/} && $target !~ /#/;
    return $self->_respond($client, 403, 'text/plain', 'Invalid Host header')
        unless $self->_valid_host($headers{host});
    return $self->_respond($client, 400, 'text/plain', 'Transfer-Encoding is not supported')
        if defined($headers{'transfer-encoding'}) && length($headers{'transfer-encoding'});
    return $self->_respond($client, 403, 'text/plain', 'Cross-origin write denied')
        if $method eq 'POST' && !$self->_valid_origin($headers{origin}, $headers{host});
    my $length = $headers{'content-length'} || 0;
    return $self->_respond($client, 400, 'text/plain', 'Invalid Content-Length')
        unless $length =~ /^\d+$/;
    return $self->_respond($client, 413, 'text/plain', 'Request too large') if $length > $self->{max_request};
    my $body = '';
    if ($length) {
        my $remaining = $length;
        while ($remaining > 0) {
            my $read = read($client, my $chunk, $remaining > 65536 ? 65536 : $remaining);
            last unless $read;
            $body .= $chunk;
            $remaining -= $read;
        }
        return $self->_respond($client, 400, 'text/plain', 'Incomplete body') if length($body) != $length;
    }
    my ($path, $query) = split /\?/, $target, 2;
    # In an HTTP path, "+" is a literal plus.  Only form-style query strings
    # use "+" as a spelling of space.
    $path = _url_decode($path, 0);
    return $self->_respond($client, 400, 'text/plain', 'Unsafe path') if $path =~ /\0|\.\./;
    my $params = _query($query || '');

    if ($path =~ m{^/__tsuzuri(?:/|$)}) {
        return $self->_admin($client, $method, $path, $params, $body);
    }
    return $self->_respond($client, 405, 'text/plain', 'Method not allowed') unless $method eq 'GET' || $method eq 'HEAD';
    return $self->_serve_file($client, $method, $self->{root}, $path);
}

sub _admin {
    my ($self, $client, $method, $path, $params, $body) = @_;
    # Protect the editor document itself. Otherwise a trusted standalone page
    # on this origin could fetch it, extract the embedded token, and then edit.
    return $self->_forbidden($client) unless $self->_authorized($params);

    if ($path eq '/__tsuzuri/api/ping' && $method eq 'GET') {
        return $self->_json($client, 200, { ok => \1, version => time });
    }
    if ($path eq '/__tsuzuri/api/list' && $method eq 'GET') {
        my $base = File::Spec->catdir($self->{site_root}, 'content');
        my ($probe, $path_error) = $self->_content_path('content/.tsuzuri-probe.md', 1);
        return $self->_respond($client, 403, 'text/plain', $path_error) unless $probe;
        my @files;
        for my $file (@{list_files($base)}) {
            next unless $file =~ /\.md$/i;
            my $rel = File::Spec->abs2rel($file, $self->{site_root});
            $rel =~ tr{\\}{/};
            my ($safe) = $self->_content_path($rel, 0);
            next unless $safe;
            push @files, $rel;
        }
        return $self->_json($client, 200, { files => \@files });
    }
    if ($path eq '/__tsuzuri/api/file' && $method eq 'GET') {
        my $rel = $params->{path} || '';
        my ($file, $path_error) = $self->_content_path($rel, 0);
        return $self->_respond($client, 400, 'text/plain', $path_error) unless $file;
        return $self->_respond($client, 404, 'text/plain', 'Not found') unless -f $file && !-l $file;
        return $self->_json($client, 200, { path => $rel, content => slurp_utf8($file) });
    }
    if ($path eq '/__tsuzuri/api/file' && $method eq 'POST') {
        my $rel = $params->{path} || '';
        my ($file, $path_error) = $self->_content_path($rel, 1);
        return $self->_respond($client, 400, 'text/plain', $path_error) unless $file;
        my $text;
        my $decoded = eval {
            $text = decode('UTF-8', $body, FB_CROAK);
            1;
        };
        return $self->_respond($client, 400, 'text/plain', 'Body must be valid UTF-8')
            unless $decoded;
        # Atomic replacement avoids following a final symlink if one somehow
        # appears after validation; existing symlink components are rejected.
        atomic_write($file, $text);
        my $result = $self->{build} ? $self->{build}->() : { ok => \1 };
        return $self->_json($client, 200, { ok => \1, build => $result });
    }
    if ($path eq '/__tsuzuri/api/build' && $method eq 'POST') {
        my $result = $self->{build} ? $self->{build}->() : { ok => \1 };
        return $self->_json($client, 200, { ok => \1, build => $result });
    }
    if ($path eq '/__tsuzuri/' || $path eq '/__tsuzuri') {
        return $self->_respond($client, 405, 'text/plain', 'Method not allowed')
            unless $method eq 'GET' || $method eq 'HEAD';
        my $html = _admin_html($self->{token});
        my $bytes = encode('UTF-8', $html);
        return $self->_respond($client, 200, 'text/html; charset=utf-8',
            $method eq 'HEAD' ? '' : $bytes, $method eq 'HEAD' ? length($bytes) : undef);
    }
    if ($self->{admin_root}) {
        return $self->_respond($client, 405, 'text/plain', 'Method not allowed')
            unless $method eq 'GET' || $method eq 'HEAD';
        (my $sub = $path) =~ s{^/__tsuzuri/}{};
        return $self->_serve_file($client, $method, $self->{admin_root}, '/' . $sub);
    }
    return $self->_respond($client, 404, 'text/plain', 'Not found');
}

sub _authorized {
    my ($self, $params) = @_;
    return 0 unless defined $params->{token};
    return _secure_equal($params->{token}, $self->{token});
}

sub _valid_host {
    my ($self, $host) = @_;
    my ($name, $port) = _parse_authority($host, 80);
    return 0 unless defined $name && _is_loopback_host($name);
    return $port == $self->{port} ? 1 : 0;
}

sub _valid_origin {
    my ($self, $origin, $request_host) = @_;
    # This is a browser authoring API, not a general HTTP endpoint: writes
    # without Origin are refused even if their token is otherwise valid.
    return 0 unless defined $origin && $origin =~ m{^http://([^/]+)$}i;
    my ($name, $port) = _parse_authority($1, 80);
    return 0 unless defined $name && _is_loopback_host($name) && $port == $self->{port};
    if (defined $request_host) {
        my ($host_name, $host_port) = _parse_authority($request_host, 80);
        return 0 unless defined $host_name;
        return 0 unless $name eq $host_name && $port == $host_port;
    }
    return 1;
}

sub _content_path {
    my ($self, $rel, $allow_missing) = @_;
    my $error = 'Only regular Markdown files below content/ are editable';
    return (undef, $error) unless defined $rel && $rel =~ m{\Acontent/(.+\.md)\z}i;
    return (undef, $error) if $rel =~ /[\\:\x00-\x1f]/;

    my @parts = split m{/}, $rel, -1;
    return (undef, $error) unless @parts >= 2 && $parts[0] eq 'content';
    for my $part (@parts) {
        return (undef, $error) unless length($part) && $part ne '.' && $part ne '..';
        return (undef, $error) if $part =~ /[. ]\z/;
        return (undef, $error) if File::Spec->file_name_is_absolute($part);
    }

    my $cursor = File::Spec->rel2abs($self->{site_root});
    for my $index (0 .. $#parts) {
        $cursor = safe_join($cursor, $parts[$index]);
        my @stat = lstat($cursor);
        next unless @stat;
        return (undef, 'Symbolic links are not allowed in editable paths') if -l _;
        if ($index < $#parts) {
            return (undef, $error) unless -d _;
        } else {
            return (undef, $error) unless -f _;
        }
    }
    return (undef, 'Not found') unless $allow_missing || -f $cursor;
    return ($cursor, undef);
}

sub _is_loopback_host {
    my ($host) = @_;
    return 0 unless defined $host;
    $host = lc $host;
    return $host eq '127.0.0.1' || $host eq 'localhost';
}

sub _parse_authority {
    my ($authority, $default_port) = @_;
    return unless defined $authority && length $authority;
    return if $authority =~ /[\s\@,]/;
    my ($host, $port);
    if ($authority =~ /\A(\[[0-9A-Fa-f:]+\])(?::([0-9]+))?\z/) {
        ($host, $port) = (lc($1), $2);
    } elsif ($authority =~ /\A([A-Za-z0-9.-]+)(?::([0-9]+))?\z/) {
        ($host, $port) = (lc($1), $2);
    } else {
        return;
    }
    $port = $default_port unless defined $port;
    return unless defined $port && $port =~ /^\d+$/ && $port >= 1 && $port <= 65535;
    return ($host, 0 + $port);
}

sub _secure_equal {
    my ($left, $right) = @_;
    return 0 unless defined $left && defined $right && length($left) == length($right);
    my $difference = 0;
    for my $index (0 .. length($left) - 1) {
        $difference |= ord(substr($left, $index, 1)) ^ ord(substr($right, $index, 1));
    }
    return $difference == 0 ? 1 : 0;
}

sub _forbidden {
    my ($self, $client) = @_;
    return $self->_respond($client, 403, 'text/plain', 'Invalid editor token');
}

sub _serve_file {
    my ($self, $client, $method, $root, $path) = @_;
    $path =~ s{^/}{};
    $path = 'index.html' unless length $path;
    $path .= 'index.html' if $path =~ m{/$};
    my $file = safe_join($root, split m{/}, $path);
    if (-d $file) { $file = File::Spec->catfile($file, 'index.html'); }
    return $self->_respond($client, 404, 'text/html; charset=utf-8', encode('UTF-8', '<h1>404</h1>')) unless -f $file;
    open my $fh, '<:raw', $file or return $self->_respond($client, 500, 'text/plain', 'Read error');
    local $/;
    my $data = <$fh>;
    close $fh;
    $data = '' if $method eq 'HEAD';
    return $self->_respond($client, 200, _mime($file), $data, $method eq 'HEAD' ? (-s $file) : undef);
}

sub _json {
    my ($self, $client, $status, $data) = @_;
    return $self->_respond($client, $status, 'application/json; charset=utf-8', encode('UTF-8', json_encode($data)));
}

sub _respond {
    my ($self, $client, $status, $type, $body, $length_override) = @_;
    $body = '' unless defined $body;
    my %reason = (200=>'OK', 400=>'Bad Request', 403=>'Forbidden', 404=>'Not Found', 405=>'Method Not Allowed', 413=>'Payload Too Large', 500=>'Internal Server Error');
    my $length = defined($length_override) ? $length_override : length($body);
    print {$client} "HTTP/1.1 $status " . ($reason{$status} || 'Response') . "\r\n";
    print {$client} "Content-Type: $type\r\n";
    print {$client} "Content-Length: $length\r\n";
    print {$client} "X-Content-Type-Options: nosniff\r\n";
    print {$client} "Referrer-Policy: no-referrer\r\n";
    print {$client} "Cache-Control: no-store\r\n";
    print {$client} "Connection: close\r\n\r\n";
    print {$client} $body if length $body;
    return 1;
}

sub _query {
    my ($raw) = @_;
    my %out;
    for my $part (split /[&;]/, $raw) {
        next unless length $part;
        my ($key, $value) = split /=/, $part, 2;
        $out{_url_decode($key, 1)} = _url_decode(defined($value) ? $value : '', 1);
    }
    return \%out;
}

sub _url_decode {
    my ($value, $plus_as_space) = @_;
    $value = '' unless defined $value;
    $value =~ tr/+/ / if $plus_as_space;
    $value =~ s/%([0-9A-Fa-f]{2})/chr(hex($1))/eg;
    return decode('UTF-8', $value, FB_DEFAULT);
}

sub _mime {
    my ($path) = @_;
    return 'text/html; charset=utf-8' if $path =~ /\.html?$/i;
    return 'text/css; charset=utf-8' if $path =~ /\.css$/i;
    return 'text/javascript; charset=utf-8' if $path =~ /\.(?:js|mjs)$/i;
    return 'application/json; charset=utf-8' if $path =~ /\.json$/i;
    return 'application/xml; charset=utf-8' if $path =~ /\.(?:xml|rss|atom)$/i;
    return 'image/svg+xml' if $path =~ /\.svg$/i;
    return 'image/png' if $path =~ /\.png$/i;
    return 'image/jpeg' if $path =~ /\.jpe?g$/i;
    return 'image/gif' if $path =~ /\.gif$/i;
    return 'image/webp' if $path =~ /\.webp$/i;
    return 'image/x-icon' if $path =~ /\.ico$/i;
    return 'audio/mpeg' if $path =~ /\.mp3$/i;
    return 'audio/ogg' if $path =~ /\.ogg$/i;
    return 'audio/wav' if $path =~ /\.wav$/i;
    return 'video/mp4' if $path =~ /\.mp4$/i;
    return 'video/webm' if $path =~ /\.webm$/i;
    return 'application/wasm' if $path =~ /\.wasm$/i;
    return 'application/manifest+json' if $path =~ /\.webmanifest$/i;
    return 'font/woff' if $path =~ /\.woff$/i;
    return 'font/woff2' if $path =~ /\.woff2$/i;
    return 'font/ttf' if $path =~ /\.ttf$/i;
    return 'font/otf' if $path =~ /\.otf$/i;
    return 'application/octet-stream';
}

sub _new_token {
    my ($salt) = @_;
    my $entropy = '';
    if (sysopen(my $fh, '/dev/urandom', 0)) {
        my $read = read($fh, $entropy, 32);
        close $fh;
        $entropy = '' unless defined($read) && $read == 32;
    }
    $entropy .= join(':', time, $$, rand(), defined($salt) ? $salt : '');
    return substr(sha256_hex($entropy), 0, 40);
}

