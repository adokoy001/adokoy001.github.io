package Tsuzuri::Standalone;

use 5.010;
use strict;
use warnings;

use Cwd qw(abs_path);
use File::Basename qw(dirname);
use File::Find ();
use File::Path qw(mkpath);
use File::Spec ();
use Tsuzuri::Util qw(route_path_info url_encode);

our $VERSION = '0.01';

# Standalone bundles are deliberately boring directories.  The generator does
# not rewrite their HTML, CSS, JavaScript, or binary assets.  It validates the
# directory, records enough metadata for the site renderer, then copies files
# byte-for-byte to the selected public route.

sub new {
    my ($class, %args) = @_;

    my $root = defined $args{root} ? $args{root} : '.';
    my $trusted_apps = defined $args{trusted_apps} ? $args{trusted_apps} : [];
    die "trusted_apps must be an array reference\n"
        if ref($trusted_apps) ne 'ARRAY';
    my %trusted_apps;
    for my $slug (@{$trusted_apps}) {
        die "trusted_apps entries must be standalone slugs\n"
            if !defined($slug) || ref($slug);
        _validate_slug($slug);
        $trusted_apps{$slug} = 1;
    }
    my $self = bless {
        root               => File::Spec->rel2abs($root),
        source             => undef,
        output             => undef,
        external_resources => defined $args{external_resources}
            ? lc $args{external_resources} : 'warn',
        config_loader      => $args{config_loader},
        trusted_apps       => \%trusted_apps,
        warnings           => $args{warnings} || [],
        apps               => [],
    }, $class;

    $self->{source} = File::Spec->rel2abs(
        defined $args{source}
            ? $args{source}
            : File::Spec->catdir($self->{root}, 'standalone')
    );
    $self->{output} = File::Spec->rel2abs(
        defined $args{output}
            ? $args{output}
            : File::Spec->catdir($self->{root}, 'public')
    );

    _validate_policy($self->{external_resources}, 'external_resources');
    if (ref($self->{warnings}) ne 'ARRAY') {
        die "warnings must be an array reference\n";
    }
    if (defined($self->{config_loader})
            && ref($self->{config_loader}) ne 'CODE') {
        die "config_loader must be a code reference\n";
    }

    return $self;
}

sub scan {
    my ($self) = @_;
    my $source = $self->{source};

    $self->{apps} = [];
    return $self->{apps} if !-e $source;
    die "standalone source is not a directory: $source\n" if !-d $source;
    die "standalone source may not be a symbolic link: $source\n" if -l $source;

    opendir(my $dh, $source)
        or die "cannot open standalone directory $source: $!\n";
    my @names = sort grep { $_ ne '.' && $_ ne '..' && $_ !~ /^\./ }
        readdir($dh);
    closedir($dh)
        or die "cannot close standalone directory $source: $!\n";

    my @apps;
    my %routes;
    my %slugs;
    my $position = 0;

    for my $slug (@names) {
        my $dir = File::Spec->catdir($source, $slug);
        next if !-d $dir;
        die "standalone bundle may not be a symbolic link: $dir\n" if -l $dir;
        _validate_slug($slug);
        die "duplicate standalone slug: $slug\n" if $slugs{$slug}++;

        my $app = $self->_read_app($slug, $dir, $position++);
        _reserve_route(\%routes, $app->{route}, $slug, 'route');
        if ($app->{mode} eq 'framed') {
            _reserve_route(\%routes, $app->{play_route}, $slug, 'play_route');
        }
        push @apps, $app;
    }

    $self->{apps} = \@apps;
    return $self->{apps};
}

sub apps {
    my ($self) = @_;
    return $self->{apps};
}

sub warnings {
    my ($self) = @_;
    return $self->{warnings};
}

sub build {
    my ($self, $apps) = @_;
    $apps = $self->scan() if !defined $apps;
    die "apps must be an array reference\n" if ref($apps) ne 'ARRAY';

    die "output may not be a symbolic link: $self->{output}\n"
        if -l $self->{output};
    mkpath($self->{output}) if !-d $self->{output};

    my @pages;
    for my $app (@{$apps}) {
        $self->copy_bundle($app);
        my $page = $self->landing_context($app);
        push @pages, $page if defined $page;
    }

    return {
        apps     => $apps,
        pages    => \@pages,
        warnings => $self->{warnings},
    };
}

sub copy_bundle {
    my ($self, $app) = @_;
    die "app record must be a hash reference\n" if ref($app) ne 'HASH';

    my $mode = $app->{mode};
    if ($mode eq 'raw') {
        my $dest = $self->_destination_for_route($app->{route});
        $self->_copy_tree($app->{source_dir}, $dest, undef);
    }
    elsif ($mode eq 'framed') {
        my $dest = $self->_destination_for_route($app->{play_route});
        $self->_copy_tree($app->{source_dir}, $dest, undef);
    }
    elsif ($mode eq 'integrated') {
        my $dest = $self->_destination_for_route($app->{route});
        # The renderer owns the destination index page.  Every other asset
        # keeps the same relative name it had in the source bundle.
        $self->_copy_tree($app->{source_dir}, $dest, $app->{entry});
    }
    else {
        die "unsupported standalone mode: $mode\n";
    }

    return 1;
}

sub landing_context {
    my ($self, $app) = @_;
    return undef if $app->{mode} eq 'raw';

    my %context = (
        id          => $app->{id},
        kind        => 'standalone',
        mode        => $app->{mode},
        route       => $app->{route},
        title       => $app->{title},
        description => $app->{description},
        category    => $app->{category},
        tags        => [ @{$app->{tags}} ],
        thumbnail   => $app->{thumbnail_url},
        searchable  => $app->{searchable},
        sitemap     => $app->{sitemap},
        navigation  => $app->{navigation},
        standalone  => $app,
    );

    if ($app->{mode} eq 'framed') {
        $context{template}       = 'standalone-framed';
        $context{iframe_src}     = $app->{launch_url};
        $context{iframe_title}   = $app->{title};
        $context{iframe_sandbox} = $app->{iframe_sandbox};
        $context{allow}          = $app->{iframe_allow};
        $context{fullscreen}     = $app->{fullscreen};
    }
    else {
        $context{template}             = 'standalone-integrated';
        $context{body_html}            = $app->{integrated_body_html};
        $context{head_html}            = $app->{integrated_head_html};
        $context{force_document_load}  = 1;
    }

    return \%context;
}

sub listing_context {
    my ($self, $app) = @_;
    return {
        id          => $app->{id},
        kind        => 'standalone',
        mode        => $app->{mode},
        slug        => $app->{slug},
        title       => $app->{title},
        description => $app->{description},
        category    => $app->{category},
        tags        => [ @{$app->{tags}} ],
        url         => $app->{public_url},
        launch_url  => $app->{launch_url},
        thumbnail   => $app->{thumbnail_url},
        searchable  => $app->{searchable},
        position    => $app->{position},
    };
}

sub audit_bundle {
    my ($self, $dir, $policy, $allowed) = @_;
    $policy = $self->{external_resources} if !defined $policy;
    _validate_policy($policy, 'external_resources');
    $allowed ||= [];
    die "allowed external origins must be an array reference\n"
        if ref($allowed) ne 'ARRAY';
    $allowed = _array($allowed, 'allowed external origins');

    my @findings;
    my @files = $self->_tree_entries($dir);
    for my $rel (@files) {
        next if $rel !~ /\.(?:html?|css|js|mjs|json|svg|xml|webmanifest)\z/i;
        my $path = File::Spec->catfile($dir, split('/', $rel));
        my $text = _slurp_raw($path);
        my $line_number = 0;
        for my $line (split(/\n/, $text, -1)) {
            $line_number++;
            while ($line =~ m{((?:https?:)?//[^\s\"'<>\\)\]]+)}ig) {
                my $url = $1;
                $url =~ s/[.,;:]\z//;
                next if _url_allowed($url, $allowed);
                push @findings, {
                    path => $rel,
                    line => $line_number,
                    url  => $url,
                };
            }
        }
    }

    if (@findings && $policy eq 'deny') {
        my $first = $findings[0];
        die "external resource denied in $first->{path}:$first->{line}: "
            . "$first->{url}\n";
    }
    if (@findings && $policy eq 'warn') {
        for my $finding (@findings) {
            push @{$self->{warnings}}, {
                code    => 'standalone.external_resource',
                message => "external resource in $finding->{path}:"
                    . "$finding->{line}: $finding->{url}",
                %{$finding},
            };
        }
    }

    return \@findings;
}

sub _read_app {
    my ($self, $slug, $dir, $position) = @_;
    my $manifest = File::Spec->catfile($dir, 'app.conf');
    my $config = {};
    my $has_manifest = 0;
    if (-e $manifest) {
        die "app.conf may not be a symbolic link: $manifest\n" if -l $manifest;
        die "app.conf is not a regular file: $manifest\n" if !-f $manifest;
        $config = $self->_load_config($manifest);
        die "app.conf must contain a mapping: $manifest\n"
            if ref($config) ne 'HASH';
        $has_manifest = 1;
    }

    $self->_validate_tree($dir);

    my $mode_explicit = exists $config->{mode};
    my $mode = lc(_scalar($config->{mode}, 'framed'));
    die "invalid standalone mode '$mode' for $slug\n"
        if $mode ne 'raw' && $mode ne 'framed' && $mode ne 'integrated';

    my $entry = _scalar($config->{entry}, 'index.html');
    _validate_relative_path($entry, "entry for $slug");
    die "standalone entry may not be app.conf: $slug\n" if $entry eq 'app.conf';
    my $entry_path = File::Spec->catfile($dir, split('/', $entry));
    die "standalone entry does not exist: $entry_path\n" if !-f $entry_path;
    die "standalone entry may not be a symbolic link: $entry_path\n"
        if -l $entry_path;

    my $route_default = $mode eq 'framed'
        ? "/games/$slug/" : "/apps/$slug/";
    my $route = _normalise_route(
        _scalar($config->{route}, $route_default), "route for $slug");
    my $play_route = $mode eq 'framed'
        ? _normalise_route(
            _scalar($config->{play_route}, $route . 'play/'),
            "play_route for $slug")
        : undef;

    if ($mode eq 'framed'
            && index($play_route, $route) != 0) {
        # This is not required for correctness, but keeping play beneath its
        # landing page makes portable static hosting and relative URLs sane.
        die "play_route for $slug must be below its route\n";
    }

    # Unknown bundles are always framed and sandboxed.  Executing any bundle
    # as trusted code requires both an app.conf declaration and an independent
    # site-level allowlist entry; app-controlled metadata cannot approve itself.
    my $trust_explicit = exists $config->{trust};
    my $trust = lc(_scalar($config->{trust}, 'sandboxed'));
    die "invalid trust '$trust' for $slug\n"
        if $trust ne 'trusted' && $trust ne 'sandboxed';
    if ($mode eq 'raw' || $mode eq 'integrated') {
        die "$mode bundle '$slug' must explicitly set mode = $mode in app.conf\n"
            unless $has_manifest && $mode_explicit;
        die "$mode bundle '$slug' must explicitly set trust = trusted in app.conf\n"
            unless $trust_explicit && $trust eq 'trusted';
    }
    if ($trust eq 'trusted' && !$self->{trusted_apps}{$slug}) {
        die "trusted standalone bundle '$slug' requires approval in "
            . "[standalone] trusted_apps\n";
    }

    my $policy = lc(_scalar($config->{external_resources},
        $self->{external_resources}));
    _validate_policy($policy, "external_resources for $slug");
    my $allowed = _array($config->{allowed_external_origins},
        'allowed_external_origins');
    my $findings = $self->audit_bundle($dir, $policy, $allowed);

    my $title = _scalar(
        defined($config->{title}) ? $config->{title} : $config->{name},
        _human_title($slug));
    my $description = _scalar($config->{description}, '');
    my $category = _scalar($config->{category}, 'app');
    my $tags = _array($config->{tags}, 'tags');
    my $thumbnail = _scalar($config->{thumbnail}, '');
    if ($thumbnail ne '') {
        _validate_relative_path($thumbnail, "thumbnail for $slug");
        my $thumb_path = File::Spec->catfile($dir, split('/', $thumbnail));
        die "thumbnail does not exist: $thumb_path\n" if !-f $thumb_path;
    }

    my $copy_route = $mode eq 'framed' ? $play_route : $route;
    my $launch_url = $copy_route . _encode_relative_url_path($entry);
    $launch_url = $copy_route if $entry eq 'index.html';

    my @sandbox;
    if ($trust eq 'sandboxed') {
        @sandbox = ('allow-scripts');
        push @sandbox, 'allow-forms' if _bool($config->{forms}, 0);
        push @sandbox, 'allow-downloads' if _bool($config->{downloads}, 0);
        push @sandbox, 'allow-pointer-lock' if _bool($config->{pointer_lock}, 0);
        push @sandbox, 'allow-popups' if _bool($config->{popups}, 0);
    }

    my @allow;
    push @allow, 'fullscreen' if _bool($config->{fullscreen}, 1);
    push @allow, 'gamepad' if _bool($config->{gamepad}, 1);
    push @allow, 'autoplay' if _bool($config->{autoplay}, 0);

    my $thumbnail_url = '';
    if ($thumbnail ne '') {
        $thumbnail_url = $copy_route . _encode_relative_url_path($thumbnail);
    }

    my $app = {
        id                       => 'standalone:' . $slug,
        kind                     => 'standalone',
        slug                     => $slug,
        source_dir               => $dir,
        manifest_path            => $has_manifest ? $manifest : undef,
        entry                    => $entry,
        mode                     => $mode,
        trust                    => $trust,
        route                    => $route,
        play_route               => $play_route,
        copy_route               => $copy_route,
        public_url               => $mode eq 'raw' ? $launch_url : $route,
        launch_url               => $launch_url,
        title                    => $title,
        name                     => $title,
        description              => $description,
        category                 => $category,
        tags                     => $tags,
        thumbnail                => $thumbnail,
        thumbnail_url            => $thumbnail_url,
        searchable               => _bool($config->{searchable}, 1),
        sitemap                  => _bool($config->{sitemap}, 1),
        offline                  => _bool($config->{offline}, 0),
        fullscreen               => _bool($config->{fullscreen}, 1),
        external_resources       => $policy,
        external_findings        => $findings,
        allowed_external_origins => $allowed,
        iframe_sandbox           => @sandbox ? join(' ', @sandbox) : undef,
        iframe_allow             => join('; ', @allow),
        navigation               => $mode eq 'framed' ? 'hybrid' : 'document',
        position                 => $position,
        config                   => $config,
    };

    if ($mode eq 'integrated') {
        my ($head, $body) = _extract_integrated_html($entry_path);
        $app->{integrated_head_html} = $head;
        $app->{integrated_body_html} = $body;
    }

    return $app;
}

sub _load_config {
    my ($self, $path) = @_;
    if ($self->{config_loader}) {
        return $self->{config_loader}->($path);
    }

    require Tsuzuri::Config;
    return Tsuzuri::Config->load($path);
}

sub _validate_tree {
    my ($self, $dir) = @_;
    $self->_tree_entries($dir);
    return 1;
}

sub _tree_entries {
    my ($self, $dir) = @_;
    my @files;
    my $root = File::Spec->rel2abs($dir);
    die "standalone bundle may not be a symbolic link: $root\n" if -l $root;
    die "standalone bundle is not a directory: $root\n" if !-d $root;

    File::Find::find({
        no_chdir => 1,
        wanted   => sub {
            my $path = $File::Find::name;
            return if $path eq $root;

            my @st = lstat($path);
            die "cannot inspect standalone path $path: $!\n" if !@st;
            die "symbolic links are not allowed in standalone bundles: $path\n"
                if -l _;
            if (-d _) {
                return;
            }
            die "only regular files are allowed in standalone bundles: $path\n"
                if !-f _;

            my $rel = File::Spec->abs2rel($path, $root);
            $rel =~ s{\\}{/}g;
            _validate_relative_path($rel, 'bundle path');
            push @files, $rel;
        },
    }, $root);

    return sort @files;
}

sub _copy_tree {
    my ($self, $source, $dest, $skip) = @_;
    my @files = $self->_tree_entries($source);
    for my $rel (@files) {
        next if defined($skip) && $rel eq $skip;
        # app.conf controls publication; it is not part of the public bundle.
        next if $rel eq 'app.conf';

        my $src = File::Spec->catfile($source, split('/', $rel));
        my $dst = File::Spec->catfile($dest, split('/', $rel));
        my $parent = dirname($dst);
        $self->_make_safe_directory($parent);
        _copy_raw($src, $dst);
    }
    return 1;
}

sub _make_safe_directory {
    my ($self, $dir) = @_;
    my $output = $self->{output};
    my $relative = File::Spec->abs2rel($dir, $output);
    die "destination escapes output directory: $dir\n"
        if $relative eq '..' || $relative =~ /^\.\.(?:[\\\/]|\z)/;

    my $current = $output;
    die "output path is a symbolic link: $current\n" if -l $current;
    if (!-d $current) {
        mkpath($current);
    }

    for my $part (File::Spec->splitdir($relative)) {
        next if $part eq '' || $part eq '.';
        $current = File::Spec->catdir($current, $part);
        die "destination path is a symbolic link: $current\n" if -l $current;
        if (-e $current && !-d $current) {
            die "destination directory is occupied by a file: $current\n";
        }
        mkdir($current) if !-d $current;
        die "cannot create destination directory $current: $!\n"
            if !-d $current;
    }
    return 1;
}

sub _destination_for_route {
    my ($self, $route) = @_;
    $route = _normalise_route($route, 'route');
    my @parts = @{route_path_info($route, label => 'route')->{parts}};
    my $dest = File::Spec->catdir($self->{output}, @parts);
    my $relative = File::Spec->abs2rel($dest, $self->{output});
    die "route escapes output directory: $route\n"
        if $relative eq '..' || $relative =~ /^\.\.(?:[\\\/]|\z)/;
    return $dest;
}

sub _copy_raw {
    my ($source, $dest) = @_;
    die "destination file is a symbolic link: $dest\n" if -l $dest;
    die "standalone file conflicts with existing output: $dest\n" if -e $dest;
    open(my $in, '<:raw', $source)
        or die "cannot read standalone file $source: $!\n";
    open(my $out, '>:raw', $dest)
        or die "cannot write standalone file $dest: $!\n";

    my $buffer;
    while (1) {
        my $read = read($in, $buffer, 64 * 1024);
        die "cannot read standalone file $source: $!\n" if !defined $read;
        last if $read == 0;
        my $offset = 0;
        while ($offset < $read) {
            my $written = syswrite($out, $buffer, $read - $offset, $offset);
            die "cannot write standalone file $dest: $!\n"
                if !defined $written;
            die "short write made no progress for standalone file $dest\n"
                if $written == 0;
            $offset += $written;
        }
    }

    close($in) or die "cannot close standalone file $source: $!\n";
    close($out) or die "cannot close standalone file $dest: $!\n";
    my @st = stat($source);
    chmod($st[2] & 0777, $dest) if @st;
    return 1;
}

sub _extract_integrated_html {
    my ($path) = @_;
    my $html = _slurp_raw($path);
    my ($head) = $html =~ m{<head\b[^>]*>(.*?)</head\s*>}is;
    $head = '' if !defined $head;

    my $body;
    if ($html =~ m{<!--\s*TSUZURI:CONTENT_START\s*-->(.*?)<!--\s*TSUZURI:CONTENT_END\s*-->}is) {
        $body = $1;
    }
    elsif ($html =~ m{<body\b[^>]*>(.*?)</body\s*>}is) {
        $body = $1;
    }
    else {
        die "integrated entry has neither content markers nor a body element: $path\n";
    }

    # A base element can silently redirect every site URL.  Integrated bundles
    # use route-relative assets, so a base element is both unnecessary and
    # unsafe.  Charset, viewport, and title belong to the outer document.
    $head =~ s{<base\b[^>]*>}{}gis;
    $head =~ s{<title\b[^>]*>.*?</title\s*>}{}gis;
    $head =~ s{<meta\b[^>]*(?:charset\s*=|name\s*=\s*["']?viewport)[^>]*>}{}gis;

    return ($head, $body);
}

sub _slurp_raw {
    my ($path) = @_;
    open(my $fh, '<:raw', $path) or die "cannot read $path: $!\n";
    local $/;
    my $content = <$fh>;
    close($fh) or die "cannot close $path: $!\n";
    return defined($content) ? $content : '';
}

sub _validate_slug {
    my ($slug) = @_;
    die "invalid standalone directory name '$slug'\n"
        if $slug !~ /\A[A-Za-z0-9][A-Za-z0-9_-]*\z/;
    return 1;
}

sub _validate_relative_path {
    my ($path, $label) = @_;
    $label ||= 'path';
    die "$label must be a non-empty relative path\n"
        if !defined($path) || $path eq '';
    die "$label contains an unsafe character: $path\n"
        if $path =~ /[\x00-\x1f\\]/ || File::Spec->file_name_is_absolute($path);
    my @parts = split('/', $path, -1);
    for my $part (@parts) {
        die "$label contains an unsafe path segment: $path\n"
            if $part eq '' || $part eq '.' || $part eq '..';
    }
    return 1;
}

sub _normalise_route {
    my ($route, $label) = @_;
    $label ||= 'route';
    die "$label must begin and end with '/': $route\n"
        if !defined($route) || $route !~ m{\A/.*?/\z};
    die "$label contains an unsafe character: $route\n"
        if $route =~ /[\x00-\x20\\?#]/;
    die "$label contains duplicate separators: $route\n"
        if $route =~ m{//};
    die "$label contains an unsafe path segment: $route\n"
        if $route =~ m{/(?:\.|\.\.)/};
    die "$label contains unsupported characters: $route\n"
        if $route !~ m{\A/[A-Za-z0-9._~%/-]*/\z};
    return route_path_info($route, label => $label)->{route};
}

sub _encode_relative_url_path {
    my ($path) = @_;
    return join('/', map { url_encode($_) } split('/', $path, -1));
}

sub _reserve_route {
    my ($seen, $route, $slug, $field) = @_;
    if (exists $seen->{$route}) {
        die "standalone route collision at $route ($seen->{$route}{slug} and $slug)\n";
    }
    for my $existing (keys %{$seen}) {
        next if $seen->{$existing}{slug} eq $slug;
        if (index($route, $existing) == 0 || index($existing, $route) == 0) {
            die "overlapping standalone routes $existing and $route "
                . "($seen->{$existing}{slug} and $slug)\n";
        }
    }
    $seen->{$route} = {slug => $slug, field => $field};
    return 1;
}

sub _validate_policy {
    my ($policy, $label) = @_;
    $label ||= 'policy';
    die "invalid $label '$policy' (expected allow, warn, or deny)\n"
        if !defined($policy)
            || ($policy ne 'allow' && $policy ne 'warn' && $policy ne 'deny');
    return 1;
}

sub _url_allowed {
    my ($url, $allowed) = @_;
    my $normal = lc($url);
    $normal =~ s{/\z}{};
    for my $item (@{$allowed}) {
        next if !defined $item || ref($item);
        my $candidate = lc($item);
        $candidate =~ s{/\z}{};
        return 1 if $normal eq $candidate;
        return 1 if index($normal, $candidate . '/') == 0;
    }
    return 0;
}

sub _human_title {
    my ($slug) = @_;
    my $title = $slug;
    $title =~ tr/_-/  /;
    $title =~ s/\b([a-z])/uc($1)/ge;
    return $title;
}

sub _scalar {
    my ($value, $default) = @_;
    return $default if !defined $value;
    die "configuration value must be a scalar\n" if ref($value);
    my $text = "$value";
    die "configuration scalar contains a control character\n"
        if $text =~ /[\x00-\x1F\x7F-\x9F]/;
    return $text;
}

sub _array {
    my ($value, $label) = @_;
    $label ||= 'configuration array';
    return [] if !defined $value;
    my @items = ref($value) eq 'ARRAY' ? @{$value} : ($value);
    my @flat;
    for my $item (@items) {
        die "$label entries must be defined scalars\n"
            if !defined($item) || ref($item);
        my $text = "$item";
        die "$label entries may not contain control characters\n"
            if $text =~ /[\x00-\x1F\x7F-\x9F]/;
        push @flat, $text;
    }
    return \@flat;
}

sub _bool {
    my ($value, $default) = @_;
    return $default ? 1 : 0 if !defined $value;
    return $value ? 1 : 0 if ref($value) eq '' && $value =~ /\A(?:0|1)\z/;
    if (ref($value) eq '') {
        return 1 if lc($value) eq 'true' || lc($value) eq 'yes'
            || lc($value) eq 'on';
        return 0 if lc($value) eq 'false' || lc($value) eq 'no'
            || lc($value) eq 'off';
    }
    die "configuration value must be boolean\n";
}

1;

__END__

=head1 NAME

Tsuzuri::Standalone - validate and publish self-contained static applications

=head1 SYNOPSIS

  my $standalone = Tsuzuri::Standalone->new(
      root => $site_root,
      external_resources => 'deny',
      trusted_apps => ['reviewed-app'],
  );
  my $result = $standalone->build;
  my $apps   = $result->{apps};
  my $pages  = $result->{pages};

=head1 APP RECORDS

C<scan> returns an array reference sorted by directory name.  Each record has
C<mode>, C<route>, C<launch_url>, publication metadata, external-resource
findings, and a C<navigation> hint.  C<raw> bundles are copied directly to
C<route>.  C<framed> bundles are copied to C<play_route> and produce an iframe
landing-page context.  C<integrated> bundles copy all assets except the entry
HTML and produce C<head_html> and C<body_html> for the site renderer.

=head1 SECURITY

Bundle paths must be relative, routes cannot contain traversal syntax, and
symbolic links or special files are rejected.  Bundles without C<app.conf>
default to framed, sandboxed publication.  Every trusted bundle requires both
an explicit manifest declaration and an independent C<trusted_apps> site
allowlist entry; raw and integrated modes must also be explicitly selected.
External HTTP resources can be allowed, warned about, or rejected.  The source
C<app.conf> is not copied to public output.

=cut

