    my $escaped = 0;
    my $code = 0;
    for (my $i = 0; $i < length($line); $i++) {
        my $c = substr($line, $i, 1);
        if ($escaped) { $escaped = 0; next; }
        if ($c eq '\\') { $escaped = 1; next; }
        if ($c eq '`') { $code = !$code; next; }
        return 1 if $c eq '|' && !$code;
